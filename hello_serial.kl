// Kaula 裸机串口 Hello World
// 编译: kaulac --freestanding --template kaula-compiler\templates --entry _kaula_entry hello_serial.kl

// x86 串口 COM1 端口地址
const SERIAL_PORT = 0x3F8

// 串口寄存器偏移
const UART_THR = 0
const UART_LSR = 5
const UART_DLL = 0
const UART_DLM = 1
const UART_LCR = 3

// LSR 标志
const LSR_THRE = 0x20

// LCR 标志
const LCR_DLAB = 0x80

// 向 I/O 端口写入字节
#[inline, asm]
fn outb(u16 port, u8 val) {
    __asm__ __volatile__("outb %0, %1" : : "a"(val), "d"(port));
}

// 从 I/O 端口读取字节
#[inline]
fn inb(u16 port) u8 {
    u8 ret
    #[asm("inb %1, %0", "=a"(ret), "d"(port))]
    return ret
}

// 等待发送缓冲区空
fn serial_wait_ready() {
    u8 status = inb(SERIAL_PORT + UART_LSR)
    while ((status & LSR_THRE) == 0) {
        status = inb(SERIAL_PORT + UART_LSR)
    }
}

// 发送单个字符
fn serial_putc(u8 c) {
    serial_wait_ready()
    outb(SERIAL_PORT + UART_THR, c)
}

// 发送字符串 - 逐字符发送，避免字符串字面量问题
fn serial_puts_cstr() {
    // "Hello, Kaula from bare metal!\n"
    outb(SERIAL_PORT + UART_THR, 0x48)  // H
    outb(SERIAL_PORT + UART_THR, 0x65)  // e
    outb(SERIAL_PORT + UART_THR, 0x6C)  // l
    outb(SERIAL_PORT + UART_THR, 0x6C)  // l
    outb(SERIAL_PORT + UART_THR, 0x6F)  // o
    outb(SERIAL_PORT + UART_THR, 0x2C)  // ,
    outb(SERIAL_PORT + UART_THR, 0x20)  // space
    outb(SERIAL_PORT + UART_THR, 0x4B)  // K
    outb(SERIAL_PORT + UART_THR, 0x61)  // a
    outb(SERIAL_PORT + UART_THR, 0x75)  // u
    outb(SERIAL_PORT + UART_THR, 0x6C)  // l
    outb(SERIAL_PORT + UART_THR, 0x61)  // a
    outb(SERIAL_PORT + UART_THR, 0x20)  // space
    outb(SERIAL_PORT + UART_THR, 0x66)  // f
    outb(SERIAL_PORT + UART_THR, 0x72)  // r
    outb(SERIAL_PORT + UART_THR, 0x6F)  // o
    outb(SERIAL_PORT + UART_THR, 0x6D)  // m
    outb(SERIAL_PORT + UART_THR, 0x20)  // space
    outb(SERIAL_PORT + UART_THR, 0x62)  // b
    outb(SERIAL_PORT + UART_THR, 0x61)  // a
    outb(SERIAL_PORT + UART_THR, 0x72)  // r
    outb(SERIAL_PORT + UART_THR, 0x65)  // e
    outb(SERIAL_PORT + UART_THR, 0x20)  // space
    outb(SERIAL_PORT + UART_THR, 0x6D)  // m
    outb(SERIAL_PORT + UART_THR, 0x65)  // e
    outb(SERIAL_PORT + UART_THR, 0x74)  // t
    outb(SERIAL_PORT + UART_THR, 0x61)  // a
    outb(SERIAL_PORT + UART_THR, 0x6C)  // l
    outb(SERIAL_PORT + UART_THR, 0x21)  // !
    outb(SERIAL_PORT + UART_THR, 0x0A)  // \n
}

// 初始化串口 (115200 波特率, 8N1)
fn serial_init() {
    outb(SERIAL_PORT + 1, 0x00)
    outb(SERIAL_PORT + UART_LCR, LCR_DLAB)
    outb(SERIAL_PORT + UART_DLL, 0x01)
    outb(SERIAL_PORT + UART_DLM, 0x00)
    outb(SERIAL_PORT + UART_LCR, 0x03)
    outb(SERIAL_PORT + 2, 0xC7)
    outb(SERIAL_PORT + 4, 0x03)
}

// Kaula 裸机主逻辑 (由模板的 _kaula_entry 调用)
fn kaula_main() i32 {
    serial_init()
    serial_puts_cstr()
    return 0
}