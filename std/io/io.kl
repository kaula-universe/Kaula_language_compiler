// io.kl — std.io 模块胶水层
//
// 包装 io.h 中 Kaula 侧不兼容的 C 句柄类型，统一走 adopt 零成本抽象。
// 用户代码：
//   import std.io
//   let f: IoFile = std.io.file_open("a.txt", "r")
//   defer std.io.file_close(f)
//
// C 侧零成本：adopt 类型即底层 C 类型，无装箱、无拆箱。

import std.ctypes

// 文件句柄：C 侧 typedef FILE* File;
// 不透明句柄，禁止比较，仅通过 std.io.file_* 系列函数操作。
type IoFile = adopt File

// 异步 I/O 句柄：C 侧 typedef void* AsyncIO;
type AsyncIO = adopt AsyncIO

// 内存流句柄：C 侧 typedef struct MemoryStream {...} MemoryStream;
type MemoryStream = adopt MemoryStream*

// 缓冲写入器句柄
type BufferedWriter = adopt BufferedWriter*

// 缓冲读取器句柄
type BufferedReader = adopt BufferedReader*
