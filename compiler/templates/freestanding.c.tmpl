// ==================== 裸机入口 ====================
// 入口函数名由 kaulac --entry 指定（默认 _start）
// 链接脚本应将此函数放置在 .text.boot 或类似段
// 入口职责：
//   1. 设置栈指针（通常由 boot.S 或链接脚本完成）
//   2. 清零 BSS 段（若 boot.S 未完成）
//   3. 调用 kaula_main（Kaula 程序的 main 函数）
//   4. 停机（hlt/wfi/无限循环）

// Kaula 程序的入口前向声明：
// UserFuncCName keeps plain kaula_main (K_ prefix removed); must match this declaration.
extern int32_t kaula_main(void);

// 裸机入口
// 用户可通过 #[section(".text.boot")] 属性控制放置位
// 约定：BSS（__bss_start..__bss_end）由 boot stub 在进入本函数前清零，
//       栈指针已由 boot stub 设置为链接脚本的 stack_top
//       若使用自定义 boot stub，请自行完成这两项
#if defined(__wasm__)
// WASM：没有停机指令（hlt/wfi 在 wasm 里无对应物），调用完 kaula_main 后直接
// 返回，由宿主 runtime（wasmtime/wasm3）决定下一步。_kaula_entry 被导出，
// 宿主可以 `--invoke _kaula_entry`。kaula_main 的返回值通过单独导出的
// kaula_main 暴露，便于 runtime 断言结果。
void _kaula_entry(void) {
    (void)kaula_main();
}
#else
__attribute__((noreturn))
void _kaula_entry(void) {
    // 参考实现（内置 boot stub 已清零，此处无需重复）：
    // extern uint8_t __bss_start[], __bss_end[];
    // for (uint8_t* p = __bss_start; p < __bss_end; ) *p++ = 0;

    // 初始化 KMM 池（静态池模式下只需重置 offset）
    // KMM_V4_STATIC_POOL 模式下池已在 BSS 段，无需 OS 调用

    // 调用 Kaula 程序入口
    (void)kaula_main();

    // 停机：永不返回
    // x86: hlt; ARM: wfi; 通用: 无限循环
#if defined(__x86_64__) || defined(__i386__)
    __asm__ __volatile__("hlt");
#else
    __asm__ __volatile__("wfi");
#endif
    while (1) { }
}
#endif
