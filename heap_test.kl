// Kaula 裸机堆分配测试（x86_64 串口输出）
// 验证 freestanding 下 KMM V4 静态池分配 + 作用域回收

import std.memory

const SERIAL_PORT = 0x3F8

#[inline, asm]
fn outb(u16 port, u8 val) {
    __asm__ __volatile__("outb %0, %1" : : "a"(val), "d"(port));
}

#[inline]
fn inb(u16 port) u8 {
    u8 ret
    #[asm("inb %1, %0", "=a"(ret), "d"(port))]
    return ret
}

fn serial_wait_ready() {
    u8 status = inb(SERIAL_PORT + 5)
    while ((status & 0x20) == 0) {
        status = inb(SERIAL_PORT + 5)
    }
}

fn serial_putc(u8 c) {
    serial_wait_ready()
    outb(SERIAL_PORT + 0, c)
}

fn serial_puts() {
    serial_putc(0x48)  // H
    serial_putc(0x45)  // E
    serial_putc(0x41)  // A
    serial_putc(0x50)  // P
    serial_putc(0x3A)  // :
    serial_putc(0x20)  // space
    serial_putc(0x4F)  // O
    serial_putc(0x4B)  // K
    serial_putc(0x21)  // !
    serial_putc(0x0A)  // \n
}

fn serial_init() {
    outb(SERIAL_PORT + 1, 0x00)
    outb(SERIAL_PORT + 3, 0x80)
    outb(SERIAL_PORT + 0, 0x01)
    outb(SERIAL_PORT + 1, 0x00)
    outb(SERIAL_PORT + 3, 0x03)
    outb(SERIAL_PORT + 2, 0xC7)
    outb(SERIAL_PORT + 4, 0x03)
}

fn kaula_main() i32 {
    serial_init()

    // 通过 std_malloc（编译期重写为 kmm_v4_alloc_auto）分配堆内存
    u8* buf = std.memory.std_malloc(1024)
    if buf != null {
        buf[0] = 0x41  // 'A'
        buf[1] = 0x42  // 'B'
        buf[2] = 0x43  // 'C'
        // 回读校验（bump 分配的内存应可写可读）
        if (buf[0] == 0x41) {
            if (buf[1] == 0x42) {
                if (buf[2] == 0x43) {
                    serial_puts()
                }
            }
        }
    } else {
        serial_putc(0x46)  // F
        serial_putc(0x41)  // A
        serial_putc(0x49)  // I
        serial_putc(0x4C)  // L
        serial_putc(0x0A)
    }
    return 0
}
