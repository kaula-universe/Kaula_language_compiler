import std.io
import std.string
import std.web
import std.system
import std.memory
import std.time

// ==================== HTTP Client ====================

struct HttpResponse {
    status_code: int,
    body: string,
    content_type: string,
    content_length: int,
}

struct MyHttpClient {
    base_url: string,
    api_key: string,
    timeout_ms: int,
    user_agent: string,
}

fn my_http_client_create(string base_url, string api_key) MyHttpClient {
    MyHttpClient client = MyHttpClient()
    client.base_url = base_url
    client.api_key = api_key
    client.timeout_ms = 30000
    client.user_agent = "Kaula-LLM-Chat/1.0"
    return client
}

fn my_http_build_url(MyHttpClient client, string path) string {
    if (string_starts_with(path, "http")) {
        return path
    }
    string url = string_copy(client.base_url)
    if (string_ends_with(url, "/") == false) {
        url = string_concat(url, string_create("/"))
    }
    url = string_concat(url, path)
    return url
}

fn my_http_auth_header(MyHttpClient client) string {
    string auth = string_create("Bearer ")
    auth = string_concat(auth, client.api_key)
    return auth
}

fn my_http_post_json(MyHttpClient client, string path, string json_body) HttpResponse {
    HttpResponse response = HttpResponse()
    response.status_code = 0
    response.body = string_create("")
    response.content_type = string_create("application/json")
    response.content_length = 0

    string url = my_http_build_url(client, path)
    int content_length = string_length(json_body)

    std.io.println("[HTTP] POST ", url)
    std.io.println("[HTTP] Content-Length: ", content_length)

    HttpClient http_client = std.web.http_client_create()
    std.web.http_client_set_timeout(http_client, client.timeout_ms)

    HttpResponse http_response = std.web.http_client_post(http_client, url, json_body, string_create("application/json"))

    if (http_response != null) {
        string resp_str = std.web.http_response_to_string(http_response)
        response.body = string_copy(resp_str)
        response.status_code = 200
        response.content_length = string_length(resp_str)
        std.web.http_response_destroy(http_response)
    } else {
        response.status_code = 0 - 1
        response.body = string_create("{\"error\":\"请求失败\"}")
    }

    std.web.http_client_destroy(http_client)
    string_free(url)
    return response
}

fn my_http_client_destroy(MyHttpClient client) {
    string_free(client.base_url)
    string_free(client.api_key)
    string_free(client.user_agent)
}

// ==================== Messages ====================

int ROLE_SYSTEM = 0
int ROLE_USER = 1
int ROLE_ASSISTANT = 2

struct ChatMessage {
    role: int,
    content: string,
}

fn chat_message_create(int role, string content) ChatMessage {
    ChatMessage msg = ChatMessage()
    msg.role = role
    msg.content = string_copy(content)
    return msg
}

fn chat_message_destroy(ChatMessage msg) {
    string_free(msg.content)
}

fn role_to_string(int role) string {
    if (role == ROLE_SYSTEM) {
        return string_create("system")
    } else if (role == ROLE_USER) {
        return string_create("user")
    } else {
        return string_create("assistant")
    }
}

// ==================== Conversation ====================

struct Conversation {
    messages: ChatMessage*,
    message_count: int,
    message_capacity: int,
    total_input_tokens: int,
    total_output_tokens: int,
    total_time_ms: i64,
    turn_count: int,
}

fn conversation_create() Conversation {
    Conversation conv = Conversation()
    conv.message_capacity = 32
    conv.messages = std.memory.std_malloc(conv.message_capacity * 48)
    conv.message_count = 0
    conv.total_input_tokens = 0
    conv.total_output_tokens = 0
    conv.total_time_ms = 0
    conv.turn_count = 0
    return conv
}

fn conversation_add_message(Conversation conv, int role, string content) {
    if (conv.message_count >= conv.message_capacity) {
        conv.message_capacity = conv.message_capacity * 2
        conv.messages = std.memory.std_malloc(conv.message_capacity * 48)
    }
    conv.messages[conv.message_count] = chat_message_create(role, content)
    conv.message_count = conv.message_count + 1
    conv.turn_count = conv.turn_count + 1
}

fn conversation_get_last_assistant(Conversation conv) string {
    int i = conv.message_count - 1
    while (i >= 0) {
        if (conv.messages[i].role == ROLE_ASSISTANT) {
            return string_copy(conv.messages[i].content)
        }
        i = i - 1
    }
    return string_create("")
}

fn conversation_clear(Conversation conv) {
    int i = 0
    while (i < conv.message_count) {
        chat_message_destroy(conv.messages[i])
        i = i + 1
    }
    conv.message_count = 0
    conv.total_input_tokens = 0
    conv.total_output_tokens = 0
    conv.total_time_ms = 0
    conv.turn_count = 0
}

fn conversation_destroy(Conversation conv) {
    conversation_clear(conv)
    std.memory.std_free(conv.messages)
}

fn conversation_print_stats(Conversation conv) {
    std.io.println("\n[统计] 本轮对话:")
    std.io.println("  输入 Tokens: ", conv.total_input_tokens)
    std.io.println("  输出 Tokens: ", conv.total_output_tokens)
    std.io.println("  总耗时: ", conv.total_time_ms, " ms")
    std.io.println("  对话轮次: ", conv.turn_count)
    std.io.println("")
}

// ==================== API Request Building ====================

fn build_request_json(Conversation conv, string model, int max_tokens) string {
    string json = string_create("{\"model\":\"")
    json = string_concat(json, model)
    json = string_concat(json, string_create("\",\"max_tokens\":"))
    json = string_concat_int(json, max_tokens)
    json = string_concat(json, string_create(",\"stream\":false,\"messages\":[") )

    int i = 0
    while (i < conv.message_count) {
        if (i > 0) {
            json = string_concat(json, string_create(","))
        }
        string role_str = role_to_string(conv.messages[i].role)
        json = string_concat(json, string_create("{\"role\":\""))
        json = string_concat(json, role_str)
        json = string_concat(json, string_create("\",\"content\":\""))

        string escaped = json_escape_string(conv.messages[i].content)
        json = string_concat(json, escaped)
        string_free(escaped)

        json = string_concat(json, string_create("\"}"))
        string_free(role_str)
        i = i + 1
    }

    json = string_concat(json, string_create("]}"))
    return json
}

fn json_escape_string(string s) string {
    string result = string_create("")
    int len = string_length(s)
    int i = 0
    while (i < len) {
        char c = string_char_at(s, i)
        if (c == '\"') {
            result = string_concat(result, string_create("\\\""))
        } else if (c == '\\') {
            result = string_concat(result, string_create("\\\\"))
        } else if (c == '\n') {
            result = string_concat(result, string_create("\\n"))
        } else if (c == '\r') {
            result = string_concat(result, string_create("\\r"))
        } else if (c == '\t') {
            result = string_concat(result, string_create("\\t"))
        } else {
            result = string_concat_char(result, c)
        }
        i = i + 1
    }
    return result
}

// ==================== API Response Parsing ====================

fn parse_response_json(string response_body) string {
    string search_key = string_create("\"content\":\"")
    int content_start = string_index_of_string(response_body, search_key)
    string_free(search_key)

    if (content_start == -1 || content_start == 0) {
        return string_create("")
    }

    int key_len = 11
    content_start = content_start + key_len
    string remaining = string_substring(response_body, content_start, string_length(response_body) - content_start)

    string result = string_create("")
    int len = string_length(remaining)
    int i = 0
    while (i < len) {
        char c = string_char_at(remaining, i)
        if (c == '\"') {
            break
        } else if (c == '\\') {
            if (i + 1 < len) {
                char next_c = string_char_at(remaining, i + 1)
                if (next_c == 'n') {
                    result = string_concat_char(result, '\n')
                } else if (next_c == 'r') {
                    result = string_concat_char(result, '\r')
                } else if (next_c == 't') {
                    result = string_concat_char(result, '\t')
                } else if (next_c == '\"') {
                    result = string_concat_char(result, '\"')
                } else if (next_c == '\\') {
                    result = string_concat_char(result, '\\')
                } else {
                    result = string_concat_char(result, c)
                    result = string_concat_char(result, next_c)
                }
                i = i + 2
                continue
            }
        }
        result = string_concat_char(result, c)
        i = i + 1
    }

    string_free(remaining)
    return result
}

// ==================== Main Program ====================

fn print_welcome() {
    std.io.println("")
    std.io.println("================================================")
    std.io.println("         Kaula LLM Chat - GLM-4.5-Air")
    std.io.println("================================================")
    std.io.println("")
    std.io.println("[系统] 模型: glm-4.5-air")
    std.io.println("[系统] 输入 /quit 退出, /clear 清空历史, /stats 查看统计")
    std.io.println("")
}

fn print_prompt() {
    std.io.print("你> ")
}

fn read_input() string {
    return std.io.read_line()
}

fn handle_command(string cmd, Conversation conv) bool {
    if (string_equals(cmd, string_create("/quit")) || string_equals(cmd, string_create("/exit"))) {
        std.io.println("[系统] 感谢使用，再见！")
        return true
    } else if (string_equals(cmd, string_create("/clear"))) {
        conversation_clear(conv)
        std.io.println("[系统] 对话历史已清空")
        return false
    } else if (string_equals(cmd, string_create("/stats"))) {
        conversation_print_stats(conv)
        return false
    } else if (string_equals(cmd, string_create("/help"))) {
        std.io.println("[命令] /quit - 退出程序")
        std.io.println("[命令] /clear - 清空对话历史")
        std.io.println("[命令] /stats - 查看统计信息")
        std.io.println("[命令] /help - 显示帮助")
        return false
    }
    return false
}

fn send_message(MyHttpClient client, Conversation conv, string user_input) string {
    conversation_add_message(conv, ROLE_USER, user_input)

    string model = string_create("glm-4.5-air")
    string request_json = build_request_json(conv, model, 4096)
    string_free(model)

    i64 start_time = std.time.time_now_ms()

    HttpResponse response = my_http_post_json(client, string_create("v4/chat/completions"), request_json)
    string_free(request_json)

    i64 end_time = std.time.time_now_ms()
    i64 elapsed = end_time - start_time

    conv.total_time_ms = conv.total_time_ms + elapsed

    string assistant_msg = string_create("")
    if (response.status_code == 200) {
        assistant_msg = parse_response_json(response.body)
        conversation_add_message(conv, ROLE_ASSISTANT, assistant_msg)
    } else {
        assistant_msg = string_create("[错误] API 请求失败 (状态码: ")
        assistant_msg = string_concat_int(assistant_msg, response.status_code)
        assistant_msg = string_concat_char(assistant_msg, ')')
    }

    string_free(response.body)
    return assistant_msg
}

fn main() {
    print_welcome()

    string api_key = std.system.system_get_env("ZHIPU_API_KEY")
    string api_key_str = string_create(api_key)

    if (string_is_empty(api_key_str)) {
        std.io.println("[错误] 未设置 ZHIPU_API_KEY 环境变量")
        std.io.println("[提示] PowerShell: $env:ZHIPU_API_KEY=\"your_key\"")
        std.io.println("[提示] Bash: export ZHIPU_API_KEY=\"your_key\"")
        string_free(api_key_str)
        return
    }

    MyHttpClient client = my_http_client_create(string_create("https://open.bigmodel.cn/api/paas"), api_key_str)
    Conversation conv = conversation_create()

    conversation_add_message(conv, ROLE_SYSTEM, string_create("你是一个有用的 AI 助手，请用中文回答问题。"))

    while (true) {
        print_prompt()
        string user_input = read_input()

        if (user_input == null || string_is_empty(user_input)) {
            string_free(user_input)
            continue
        }

        if (string_char_at(user_input, 0) == '/') {
            bool should_exit = handle_command(user_input, conv)
            string_free(user_input)
            if (should_exit) {
                break
            }
            continue
        }

        std.io.println("\n[GLM] 思考中...\n")
        string response = send_message(client, conv, user_input)

        std.io.println("GLM> ", response)
        std.io.println("")

        std.io.println("[统计] 输入: ", conv.total_input_tokens, " tokens, 输出: ", conv.total_output_tokens, " tokens")
        std.io.println("")

        string_free(response)
        string_free(user_input)
    }

    conversation_destroy(conv)
    my_http_client_destroy(client)
    string_free(api_key_str)
}
