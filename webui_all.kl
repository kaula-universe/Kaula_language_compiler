// ========== Form helpers ==========
fn form_value(string body, string key) string {
    if (s_empty(body)) { return string_create("") }
    string needle = (key) + (string_create("="))
    size_t blen = string_length(body)
    size_t idx = string_index_of_string(body, needle)
    if (idx >= blen) { return string_create("") }
    size_t nlen = string_length(needle)
    size_t start = idx + nlen
    if (start >= blen) { return string_create("") }
    size_t p = start
    size_t amp_pos = blen
    char amp_char = '&'
    while (p < blen) {
        char c = string_char_at(body, p)
        if (c == amp_char) { amp_pos = p; break }
        p = p + SZ1
    }
    size_t raw_len = blen - start
    if (amp_pos < blen) { raw_len = amp_pos - start }
    if (raw_len == SZ0) { return string_create("") }
    string raw = string_substring(body, start, raw_len)
    if (s_empty(raw)) { return string_create("") }
    char* dec = url_decode(raw.ptr)
    if (dec == null) { return string_create("") }
    return string_create(dec)
}

fn validate(string name, string email, string subj, string msg) string {
    size_t nlen = string_length(name)
    if (nlen < SZ2) { return string_create("Name too short") }
    size_t elen = string_length(email)
    if (elen < SZ5) { return string_create("Email too short") }
    size_t i = SZ0
    bool has_at = false
    char at_char = '@'
    while (i < elen) {
        char c = string_char_at(email, i)
        if (c == at_char) { has_at = true; break }
        i = i + SZ1
    }
    if (has_at) {
    } else {
        return string_create("Email missing @")
    }
    size_t slen = string_length(subj)
    if (slen < SZ3) { return string_create("Subject too short") }
    size_t mlen = string_length(msg)
    if (mlen < SZ10) { return string_create("Message too short") }
    return string_create("")
}

// ========== HTTP handler ==========
fn handle(HttpRequest* req, HttpResponse* res) {
    char* path = req.path
    char* m = http_method_to_string(req.method)

    if (m == "OPTIONS") {
        http_response_set_status(res, 204)
        http_response_set_header(res, "Access-Control-Allow-Origin", "*")
        http_response_set_header(res, "Access-Control-Allow-Methods", "GET,POST,OPTIONS")
        http_response_set_header(res, "Access-Control-Allow-Headers", "Content-Type")
        http_response_set_body(res, "", SZ0)
        return
    }

    if (m == "GET") {
        if (path == "/") {
            string html = build_home_page()
            http_response_set_status(res, 200)
            http_response_set_content_type(res, "text/html")
            http_response_set_html(res, html.ptr)
            return
        }
        if (path == "/features") {
            string html = build_features_page()
            http_response_set_status(res, 200)
            http_response_set_content_type(res, "text/html")
            http_response_set_html(res, html.ptr)
            return
        }
        if (path == "/demo") {
            string html = build_demo_page()
            http_response_set_status(res, 200)
            http_response_set_content_type(res, "text/html")
            http_response_set_html(res, html.ptr)
            return
        }
        if (path == "/contact") {
            string html = build_contact_page(string_create(""), string_create(""), string_create(""), string_create(""), string_create(""), string_create(""))
            http_response_set_status(res, 200)
            http_response_set_content_type(res, "text/html")
            http_response_set_html(res, html.ptr)
            return
        }
        if (path == "/api/health") {
            http_response_set_status(res, 200)
            http_response_set_content_type(res, "application/json")
            http_response_set_body(res, "{\"ok\":true,\"framework\":\"kaula-webui\",\"version\":\"0.1.0\"}", SZ0)
            return
        }
        if (path == "/api/features") {
            http_response_set_status(res, 200)
            http_response_set_content_type(res, "application/json")
            http_response_set_body(res, "{\"features\":[\"SSR\",\"Components\",\"Routing\",\"Forms\",\"Styles\",\"Responsive\",\"CORS\"]}", SZ0)
            return
        }
        http_response_set_header(res, "Access-Control-Allow-Origin", "*")
        string html = build_404_page()
        http_response_set_status(res, 404)
        http_response_set_content_type(res, "text/html")
        http_response_set_html(res, html.ptr)
        return
    }

    if (m == "POST") {
        if (path == "/contact") {
            string body = string_create("")
            if (req.body != null) {
                size_t l = req.body_length
                if (l > SZ0) { body = string_create(req.body) }
            }
            string nm = form_value(body, string_create("name"))
            string em = form_value(body, string_create("email"))
            string sb = form_value(body, string_create("subject"))
            string mg = form_value(body, string_create("message"))
            string err = validate(nm, em, sb, mg)
            if (s_empty(err)) {
                string html = build_contact_page(string_create("Message sent! Thanks for reaching out."), string_create(""), nm, em, sb, mg)
                http_response_set_status(res, 200)
                http_response_set_content_type(res, "text/html")
                http_response_set_html(res, html.ptr)
            } else {
                string html = build_contact_page(string_create(""), err, nm, em, sb, mg)
                http_response_set_status(res, 400)
                http_response_set_content_type(res, "text/html")
                http_response_set_html(res, html.ptr)
            }
            return
        }
        string html = build_404_page()
        http_response_set_status(res, 404)
        http_response_set_content_type(res, "text/html")
        http_response_set_html(res, html.ptr)
        return
    }

    string html = build_404_page()
    http_response_set_status(res, 404)
    http_response_set_content_type(res, "text/html")
    http_response_set_html(res, html.ptr)
}

fn main() {
    init_sz()
    HttpServer* server = http_server_create(8768)
    if (server == null) {
        println("[webui_all] http_server_create failed")
        return
    }
    http_server_enable_cors(server, "*")
    println("[webui_all] running at http://localhost:8768")
    println("Routes: / /features /demo /contact /api/health /api/features")
    http_server_start(server, handle)
    http_server_destroy(server)
}
