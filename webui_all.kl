import std.io
import std.string
import std.container
import std.memory
import std.web

// ============================================================
// Kaula WebUI Framework + Demo Application
// ============================================================

size_t SZ0
size_t SZ1
size_t SZ2
size_t SZ3
size_t SZ5
size_t SZ10

fn init_sz() void {
    SZ0 = 0
    SZ1 = 1
    SZ2 = 2
    SZ3 = 3
    SZ5 = 5
    SZ10 = 10
}

fn s_empty(string s) bool {
    size_t l = string_length(s)
    bool r = (l == SZ0)
    return r
}

// ========== Style ==========
class Style {
    css: string
    constructor() { self.css = string_create("") }
    fn append(string k, string v) void {
        string a = (self.css) + (k)
        string b = (a) + (string_create(":"))
        string c = (b) + (v)
        self.css = (c) + (string_create(";"))
    }
    fn render() string { return self.css }
    fn bg(string c) void { self.append(string_create("background"), c) }
    fn color(string c) void { self.append(string_create("color"), c) }
    fn pad(string v) void { self.append(string_create("padding"), v) }
    fn margin(string v) void { self.append(string_create("margin"), v) }
    fn rad(string v) void { self.append(string_create("border-radius"), v) }
    fn border(string v) void { self.append(string_create("border"), v) }
    fn font_sz(string v) void { self.append(string_create("font-size"), v) }
    fn font_w(string v) void { self.append(string_create("font-weight"), v) }
    fn display(string v) void { self.append(string_create("display"), v) }
    fn flex_dir(string v) void { self.append(string_create("flex-direction"), v) }
    fn align(string v) void { self.append(string_create("align-items"), v) }
    fn justify(string v) void { self.append(string_create("justify-content"), v) }
    fn gap(string v) void { self.append(string_create("gap"), v) }
    fn text_align(string v) void { self.append(string_create("text-align"), v) }
}

// ========== Elem ==========
class Elem {
    tag: string
    style_str: string
    attrs: string
    text: string
    inner: string
    constructor() {
        self.tag = string_create("")
        self.style_str = string_create("")
        self.attrs = string_create("")
        self.text = string_create("")
        self.inner = string_create("")
    }
    fn set_tag(string t) void { self.tag = t }
    fn set_text(string t) void { self.text = t }
    fn set_style(Style s) void { self.style_str = s.render() }
    fn set_style_str(string s) void { self.style_str = s }
    fn set_attr(string a) void {
        string sp = (self.attrs) + (string_create(" "))
        self.attrs = (sp) + (a)
    }
    fn add_html(string h) void { self.inner = (self.inner) + (h) }
    fn add(Elem child) void {
        string r = child.render()
        self.inner = (self.inner) + (r)
    }
    fn render() string {
        bool empty = s_empty(self.tag)
        string out = string_create("")
        if (empty) {
        } else {
            out = (out) + (string_create("<"))
            out = (out) + (self.tag)
            if (s_empty(self.style_str)) {
            } else {
                out = (out) + (string_create(" style=\""))
                out = (out) + (self.style_str)
                out = (out) + (string_create("\""))
            }
            if (s_empty(self.attrs)) {
            } else {
                out = (out) + (string_create(" "))
                out = (out) + (self.attrs)
            }
            out = (out) + (string_create(">"))
        }
        out = (out) + (self.text)
        out = (out) + (self.inner)
        if (empty) {
        } else {
            out = (out) + (string_create("</"))
            out = (out) + (self.tag)
            out = (out) + (string_create(">"))
        }
        return out
    }
}

// ========== Card ==========
class Card {
    title: string
    body_html: string
    constructor() {
        self.title = string_create("")
        self.body_html = string_create("")
    }
    fn set_title(string t) void { self.title = t }
    fn add_text(string t) void {
        string s1 = (self.body_html) + (string_create("<p>"))
        string s2 = (s1) + (t)
        self.body_html = (s2) + (string_create("</p>"))
    }
    fn add_html(string h) void { self.body_html = (self.body_html) + (h) }
    fn add_elem(Elem e) void {
        string r = e.render()
        self.body_html = (self.body_html) + (r)
    }
    fn render() string {
        string out = string_create("<div class=\"card\">")
        if (s_empty(self.title)) {
        } else {
            out = (out) + (string_create("<h3>"))
            out = (out) + (self.title)
            out = (out) + (string_create("</h3>"))
        }
        out = (out) + (self.body_html)
        out = (out) + (string_create("</div>"))
        return out
    }
}

// ========== Navbar ==========
class Navbar {
    brand: string
    links_html: string
    constructor() {
        self.brand = string_create("KaulaWeb")
        self.links_html = string_create("")
    }
    fn set_brand(string b) void { self.brand = b }
    fn add_link(string href, string label) void {
        string s1 = (string_create("<a href=\"")) + (href)
        string s2 = (s1) + (string_create("\">"))
        string s3 = (s2) + (label)
        string link = (s3) + (string_create("</a>"))
        self.links_html = (self.links_html) + (link)
    }
    fn render() string {
        string out = string_create("<nav class=\"nav\"><span class=\"brand\">")
        out = (out) + (self.brand)
        out = (out) + (string_create("</span><div class=\"nav-links\">"))
        out = (out) + (self.links_html)
        out = (out) + (string_create("</div></nav>"))
        return out
    }
}

// ========== Footer ==========
class Footer {
    text: string
    constructor(string t) { self.text = t }
    fn render() string {
        string out = string_create("<footer class=\"footer\"><p>")
        out = (out) + (self.text)
        out = (out) + (string_create("</p></footer>"))
        return out
    }
}

// ========== Page ==========
class Page {
    title: string
    body_html: string
    footer_html: string
    use_styles: bool
    constructor() {
        self.title = string_create("")
        self.body_html = string_create("")
        self.footer_html = string_create("")
        self.use_styles = false
    }
    fn set_title(string t) void { self.title = t }
    fn use_default_styles() void { self.use_styles = true }
    fn push_html(string h) void { self.body_html = (self.body_html) + (h) }
    fn push(Elem e) void {
        string r = e.render()
        self.body_html = (self.body_html) + (r)
    }
    fn push_bottom_html(string h) void { self.footer_html = (self.footer_html) + (h) }
    fn render() string {
        string css = string_create("*{margin:0;padding:0;box-sizing:border-box}body{font-family:system-ui,sans-serif;background:#f8fafc;color:#1e293b;line-height:1.6}.container{max-width:960px;margin:0 auto;padding:2rem}.nav{display:flex;justify-content:space-between;align-items:center;padding:1rem 2rem;background:#fff;border-bottom:2px solid #e2e8f0}.nav .brand{font-size:1.3rem;font-weight:700;color:#0ea5e9}.nav-links a{margin-left:1rem;text-decoration:none;color:#475569}.nav-links a:hover{color:#0ea5e9}.card{background:#fff;border-radius:12px;padding:1.5rem;margin-bottom:1rem;border:1px solid #e2e8f0}.card h3{color:#0ea5e9;margin-bottom:.5rem}.btn{display:inline-block;padding:.6rem 1.2rem;background:#0ea5e9;color:#fff;text-decoration:none;border-radius:8px}.btn-alt{background:#64748b}.grid{display:grid;gap:1rem}.cols-2{grid-template-columns:repeat(2,1fr)}.cols-3{grid-template-columns:repeat(3,1fr)}@media(max-width:768px){.cols-2,.cols-3{grid-template-columns:1fr}}.footer{text-align:center;padding:2rem;color:#64748b;border-top:1px solid #e2e8f0;margin-top:2rem}.tag{display:inline-block;padding:.2rem .6rem;border-radius:6px;font-size:.8rem;background:#e0f2fe;color:#0369a1;margin:.2rem}.tag.g{background:#dcfce7;color:#16a34a}.tag.p{background:#fae8ff;color:#9333ea}.tag.y{background:#fef9c3;color:#a16207}.alert{padding:1rem;border-radius:8px;margin:1rem 0}.alert.ok{background:#dcfce7;color:#16a34a}.alert.bad{background:#fee2e2;color:#dc2626}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:.5rem;border-bottom:1px solid #e2e8f0}th{color:#0ea5e9}input,textarea{width:100%;padding:.5rem;margin:.3rem 0;border:1px solid #cbd5e1;border-radius:6px}label{display:block;margin-top:.5rem;font-weight:600;color:#475569}h1{color:#0ea5e9;margin-bottom:1rem}p{margin-bottom:.5rem}")
        string html = string_create("<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\"><title>")
        html = (html) + (self.title)
        html = (html) + (string_create("</title>"))
        if (self.use_styles) {
            html = (html) + (string_create("<style>"))
            html = (html) + (css)
            html = (html) + (string_create("</style>"))
        }
        html = (html) + (string_create("</head><body>"))
        html = (html) + (self.body_html)
        html = (html) + (self.footer_html)
        html = (html) + (string_create("</body></html>"))
        return html
    }
}

// ========== Helpers ==========
fn build_navbar_html() string {
    Navbar nav = Navbar()
    nav.add_link(string_create("/"), string_create("Home"))
    nav.add_link(string_create("/features"), string_create("Features"))
    nav.add_link(string_create("/demo"), string_create("Demo"))
    nav.add_link(string_create("/contact"), string_create("Contact"))
    return nav.render()
}

fn build_footer_html(string text) string {
    Footer f = Footer(text)
    return f.render()
}

// ========== Page: Home ==========
