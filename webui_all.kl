    Page page = Page()
    page.set_title(string_create("KaulaWeb - Home"))
    page.use_default_styles()
    page.push_html(build_navbar_html())

    Elem container = Elem()
    container.set_tag(string_create("div"))
    container.set_attr(string_create("class=\"container\""))

    Elem hero = Elem()
    hero.set_tag(string_create("div"))
    Elem h1 = Elem()
    h1.set_tag(string_create("h1"))
    h1.set_text(string_create("Build Web UIs with Kaula"))
    hero.add(h1)
    Elem p = Elem()
    p.set_tag(string_create("p"))
    p.set_text(string_create("A server-side rendering framework with components, routing, forms, and responsive design."))
    hero.add(p)
    Elem link = Elem()
    link.set_tag(string_create("a"))
    link.set_attr(string_create("href=\"/features\""))
    link.set_attr(string_create("class=\"btn\""))
    link.set_text(string_create("Explore Features"))
    hero.add(link)
    container.add(hero)

    Elem grid = Elem()
    grid.set_tag(string_create("div"))
    grid.set_attr(string_create("class=\"grid cols-3\""))
    grid.set_style_str(string_create("margin-top:2rem"))

    Card c1 = Card()
    c1.set_title(string_create("Components"))
    c1.add_text(string_create("Navbar, Footer, Card. Build UIs from reusable widgets."))
    grid.add_html(c1.render())

    Card c2 = Card()
    c2.set_title(string_create("Routing"))
    c2.add_text(string_create("Method + path matching with pages, raw HTML, JSON endpoints."))
    grid.add_html(c2.render())

    Card c3 = Card()
    c3.set_title(string_create("Forms"))
    c3.add_text(string_create("Parse url-encoded POST bodies with validators and errors."))
    grid.add_html(c3.render())

    Card c4 = Card()
    c4.set_title(string_create("Styles"))
    c4.add_text(string_create("Programmatic Style builders or CSS utility classes."))
    grid.add_html(c4.render())

    Card c5 = Card()
    c5.set_title(string_create("Responsive"))
    c5.add_text(string_create("Mobile-aware grid helpers, flexbox layout."))
    grid.add_html(c5.render())

    Card c6 = Card()
    c6.set_title(string_create("Zero Deps"))
    c6.add_text(string_create("Uses only Kaula stdlib: http server, strings, memory, containers."))
    grid.add_html(c6.render())

    container.add(grid)
    page.push(container)
    page.push_bottom_html(build_footer_html(string_create("Built with Kaula WebUI Framework")))
    return page.render()
