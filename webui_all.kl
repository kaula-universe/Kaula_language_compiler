// ========== Page: Contact ==========
fn build_contact_page(string ok_msg, string bad_msg, string p_name, string p_email, string p_subj, string p_msg) string {
    Page page = Page()
    page.set_title(string_create("KaulaWeb - Contact"))
    page.use_default_styles()
    page.push_html(build_navbar_html())

    Elem container = Elem()
    container.set_tag(string_create("div"))
    container.set_attr(string_create("class=\"container\""))

    Elem h1 = Elem()
    h1.set_tag(string_create("h1"))
    h1.set_text(string_create("Contact Us"))
    container.add(h1)

    Elem p = Elem()
    p.set_tag(string_create("p"))
    p.set_text(string_create("Questions? Send us a message below."))
    container.add(p)

    if (s_empty(ok_msg)) {
    } else {
        Elem alert = Elem()
        alert.set_tag(string_create("div"))
        alert.set_attr(string_create("class=\"alert ok\""))
        alert.set_text(ok_msg)
        container.add(alert)
    }
    if (s_empty(bad_msg)) {
    } else {
        Elem alert = Elem()
        alert.set_tag(string_create("div"))
        alert.set_attr(string_create("class=\"alert bad\""))
        alert.set_text(bad_msg)
        container.add(alert)
    }

    Card formcard = Card()
    formcard.set_title(string_create(""))
    string form = string_create("<form method=\"POST\" action=\"/contact\">")
    form = (form) + (string_create("<label for=\"name\">Name</label><input id=\"name\" name=\"name\" type=\"text\" value=\""))
    form = (form) + (p_name)
    form = (form) + (string_create("\"><label for=\"email\">Email</label><input id=\"email\" name=\"email\" type=\"email\" value=\""))
    form = (form) + (p_email)
    form = (form) + (string_create("\"><label for=\"subject\">Subject</label><input id=\"subject\" name=\"subject\" type=\"text\" value=\""))
    form = (form) + (p_subj)
    form = (form) + (string_create("\"><label for=\"message\">Message</label><textarea id=\"message\" name=\"message\">"))
    form = (form) + (p_msg)
    form = (form) + (string_create("</textarea><div style=\"margin-top:1rem\"><button class=\"btn\" type=\"submit\">Send Message</button></div></form>"))
    formcard.add_html(form)
    container.add_html(formcard.render())

    page.push(container)
    page.push_bottom_html(build_footer_html(string_create("Kaula WebUI Contact")))
    return page.render()
}

