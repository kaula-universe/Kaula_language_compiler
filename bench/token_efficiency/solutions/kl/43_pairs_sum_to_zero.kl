// BENCH:BEGIN
import std.io

fn pairs_sum_to_zero(i64* l, i64 n) bool {
    for i in range(n) {
        for j in range(i + 1, n) {
            if l[i] + l[j] == 0 {
                return true
            }
        }
    }
    return false
}

// BENCH:END

// BENCH:MAIN:BEGIN
fn main() i32 {
    []i64 a = [2, 4, -5, 3, 5, 7]
    []i64 b = [1, 3, 5, 0]
    if pairs_sum_to_zero(b, 4) { return 1 }
    if !pairs_sum_to_zero(a, 6) { return 2 }
    std.io.println("ok")
    return 0
}
// BENCH:MAIN:END
