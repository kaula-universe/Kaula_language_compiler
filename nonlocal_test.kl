import std.io
import std.string
import std.container
import std.memory
import std.web

fn outer() void {
    i32 count = 100
    fn inner() void {
        nonlocal i32 count
        count = count + 1
        println("inner count=" + string_itoa(count))
    }
    inner()
    println("outer count=" + string_itoa(count))
}

fn main() {
    outer()
}
