import std.i18n
import std.io
import std.string

class Student {
    name: char*
    score: int
    filled: int
    fn grade() string {
        if (self.score >= 90) {
            return "优秀"
        } else if (self.score >= 80) {
            return "良好"
        } else if (self.score >= 70) {
            return "中等"
        } else if (self.score >= 60) {
            return "及格"
        } else {
            return "不及格"
        }
    }
    fn set(char* newName, int newScore) {
        self.name = newName
        self.score = newScore
        self.filled = 1
    }
    fn clear() {
        self.name = 0
        self.score = 0
        self.filled = 0
    }
    fn print_info(int index) {
        string g = self.grade()
        std.io.println(index, ". ", self.name, " - ", self.score, " (", g, ")")
    }
    constructor() {
        self.name = 0
        self.score = 0
        self.filled = 0
    }
}

Student stu1 = Student()

Student stu2 = Student()

Student stu3 = Student()

Student stu4 = Student()

Student stu5 = Student()

fn find_empty_slot() int {
    if (stu1.filled == 0) {
        return 1
    }
    if (stu2.filled == 0) {
        return 2
    }
    if (stu3.filled == 0) {
        return 3
    }
    if (stu4.filled == 0) {
        return 4
    }
    if (stu5.filled == 0) {
        return 5
    }
    return 0
}

fn add_student() int {
    int slot = find_empty_slot()
    if (slot == 0) {
        std.io.println("存储已满, 无法添加更多学生!")
        return 0
    }
    std.io.println("请输入学生姓名: ")
    char* inputName = std.io.read_line()
    string nameCopy = std.string.string_create(inputName)
    char* nameStore = nameCopy.ptr
    std.io.println("请输入成绩 (0-100): ")
    char* scoreLine = std.io.read_line()
    string scoreStr = std.string.string_create(scoreLine)
    int inputScore = std.string.string_to_int(scoreStr)
    if (inputScore < 0) {
        std.io.println("成绩无效, 必须在 0-100 之间!")
        return 0
    }
    if (inputScore > 100) {
        std.io.println("成绩无效, 必须在 0-100 之间!")
        return 0
    }
    if (slot == 1) {
        stu1.set(nameStore, inputScore)
    } else if (slot == 2) {
        stu2.set(nameStore, inputScore)
    } else if (slot == 3) {
        stu3.set(nameStore, inputScore)
    } else if (slot == 4) {
        stu4.set(nameStore, inputScore)
    } else {
        stu5.set(nameStore, inputScore)
    }
    string grade = grade_of(inputScore)
    std.io.println("已添加学生: ", nameStore, ", 成绩: ", inputScore, " (", grade, ")")
    return 1
}

fn grade_of(score: int) string {
    if (score >= 90) {
        return "优秀"
    } else if (score >= 80) {
        return "良好"
    } else if (score >= 70) {
        return "中等"
    } else if (score >= 60) {
        return "及格"
    } else {
        return "不及格"
    }
}

fn list_students() {
    std.io.println("===== 学生名单 =====")
    int count = 0
    if (stu1.filled == 1) {
        count = count + 1
        stu1.print_info(count)
    }
    if (stu2.filled == 1) {
        count = count + 1
        stu2.print_info(count)
    }
    if (stu3.filled == 1) {
        count = count + 1
        stu3.print_info(count)
    }
    if (stu4.filled == 1) {
        count = count + 1
        stu4.print_info(count)
    }
    if (stu5.filled == 1) {
        count = count + 1
        stu5.print_info(count)
    }
    if (count == 0) {
        std.io.println("暂无学生记录")
    }
    std.io.println("共 ", count, " 名学生")
}

fn show_stats() {
    int total = 0
    int count = 0
    int maxScore = 0
    int passed = 0
    if (stu1.filled == 1) {
        total = total + stu1.score
        count = count + 1
        if (stu1.score > maxScore) {
            maxScore = stu1.score
        }
        if (stu1.score >= 60) {
            passed = passed + 1
        }
    }
    if (stu2.filled == 1) {
        total = total + stu2.score
        count = count + 1
        if (stu2.score > maxScore) {
            maxScore = stu2.score
        }
        if (stu2.score >= 60) {
            passed = passed + 1
        }
    }
    if (stu3.filled == 1) {
        total = total + stu3.score
        count = count + 1
        if (stu3.score > maxScore) {
            maxScore = stu3.score
        }
        if (stu3.score >= 60) {
            passed = passed + 1
        }
    }
    if (stu4.filled == 1) {
        total = total + stu4.score
        count = count + 1
        if (stu4.score > maxScore) {
            maxScore = stu4.score
        }
        if (stu4.score >= 60) {
            passed = passed + 1
        }
    }
    if (stu5.filled == 1) {
        total = total + stu5.score
        count = count + 1
        if (stu5.score > maxScore) {
            maxScore = stu5.score
        }
        if (stu5.score >= 60) {
            passed = passed + 1
        }
    }
    if (count == 0) {
        std.io.println("暂无数据, 无法统计")
        return
    }
    int avg = total / count
    std.io.println("===== 统计信息 =====")
    std.io.println("学生人数: ", count)
    std.io.println("平均分: ", avg)
    std.io.println("最高分: ", maxScore)
    std.io.println("及格人数: ", passed)
}

fn clear_all() {
    stu1.clear()
    stu2.clear()
    stu3.clear()
    stu4.clear()
    stu5.clear()
    std.io.println("已清空所有学生记录")
}

fn show_menu() {
    std.io.println("========================")
    std.io.println("  学生成绩管理系统")
    std.io.println("========================")
    std.io.println("  1. 添加学生")
    std.io.println("  2. 查看名单")
    std.io.println("  3. 统计信息")
    std.io.println("  4. 清空记录")
    std.io.println("  0. 退出系统")
    std.io.println("========================")
    std.io.print("请选择操作: ")
}

fn main() {
    std.i18n.i18n_init()
    std.i18n.i18n_setup_console()
    std.io.println("欢迎使用学生成绩管理系统!")
    while (true) {
        show_menu()
        char* choiceLine = std.io.read_line()
        if (choiceLine == "0") {
            std.io.println("感谢使用, 再见!")
            return
        } else if (choiceLine == "1") {
            add_student()
        } else if (choiceLine == "2") {
            list_students()
        } else if (choiceLine == "3") {
            show_stats()
        } else if (choiceLine == "4") {
            clear_all()
        } else {
            std.io.println("无效选项, 请输入 0-4")
        }
    }
}
