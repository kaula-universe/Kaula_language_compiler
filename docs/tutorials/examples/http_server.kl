import std.io
import std.web
import std.time

fn handle_request(HttpRequest* req, HttpResponse* res) {
    char* method = std.web.http_method_to_string(req.method)
    char* path = req.path
    std.io.println("Received: ", method, " ", path)

    if (path == "/") {
        std.web.http_response_set_status(res, 200)
        std.web.http_response_set_content_type(res, "text/html")
        std.web.http_response_set_html(res, "<html><body><h1>Kaula HTTP Server</h1><p><a href=\"/hello\">/hello</a></p><p><a href=\"/json\">/json</a></p><p><a href=\"/time\">/time</a></p></body></html>")
    } else if (path == "/hello") {
        std.web.http_response_set_status(res, 200)
        std.web.http_response_set_content_type(res, "text/plain")
        std.web.http_response_set_body(res, "Hello from Kaula!", 0)
    } else if (path == "/json") {
        std.web.http_response_set_status(res, 200)
        std.web.http_response_set_json(res, "{\"msg\": \"ok\"}")
    } else if (path == "/time") {
        std.web.http_response_set_status(res, 200)
        std.web.http_response_set_content_type(res, "text/plain")
        std.web.http_response_set_body(res, std.time.time_format_now("%Y-%m-%d %H:%M:%S"), 0)
    } else {
        std.web.http_response_set_status(res, 404)
        std.web.http_response_set_content_type(res, "text/plain")
        std.web.http_response_set_body(res, "404 Not Found", 0)
    }
}

fn main() {
    HttpServer* server = std.web.http_server_create(8080)
    if (server == null) {
        std.io.println("Failed to create server")
        return
    }
    std.web.http_server_enable_cors(server, "*")
    std.io.println("Listening on http://localhost:8080")
    std.web.http_server_start(server, handle_request)
    std.web.http_server_destroy(server)
}