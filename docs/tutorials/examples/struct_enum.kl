import std.io

struct Point {
    x: int,
    y: int
}

struct Rectangle {
    tl: Point,
    br: Point
}

fn area(Rectangle r) int {
    int w = r.br.x - r.tl.x
    int h = r.br.y - r.tl.y
    return w * h
}

enum Color {
    Red,
    Green,
    Blue
}

fn main() {
    int a = 100
    println("Area: ", a)

    Color c = Color.Red
    println("Color enum value")
}
