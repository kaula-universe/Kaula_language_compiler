import std.io

struct Point {
    x: i32,
    y: i32
}

struct Rectangle {
    tl: Point,
    br: Point
}

fn area(Rectangle r) i32 {
    i32 w = r.br.x - r.tl.x
    i32 h = r.br.y - r.tl.y
    return w * h
}

enum Color {
    Red,
    Green,
    Blue
}

fn main() {
    i32 a = 100
    std.io.println("Area: ", a)

    Color c = Color.Red
    std.io.println("Color enum value")
}
