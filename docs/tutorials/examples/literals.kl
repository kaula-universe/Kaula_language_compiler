// literals.kl —— 字面量与初始化教程完整示例
//
// 配套教程：docs/tutorials/literals.md
// 由回归语料 test/literal_semantics.kl 提炼：把"缺陷守护断言"改写为可读的用法演示。
//
// 编译运行：
//     kaulac docs/tutorials/examples/literals.kl -o literals && ./literals

import std.io

struct Point {
    x: i64,
    y: i64
}

fn main() {
    // ---- 1. 切片字面量：元素宽度跟着类型走 ----
    []i32 small = [1, 3, 1990]
    []i64 large = [1, 3, 1990]
    std.io.println("[1] []i32 求和 = ", small[0] + small[1] + small[2])
    std.io.println("[1] []i64 求和 = ", large[0] + large[1] + large[2])

    // ---- 2. 定长数组：方括号初始化（推荐）----
    i32 arr[5] = [10, 20, 30, 40, 50]
    i32 sum = 0
    for v in arr {
        sum = sum + v
    }
    std.io.println("[2] 定长数组求和 = ", sum)

    // ---- 3. 定长数组：花括号初始化（兼容写法）----
    i32 braces[5] = {10, 20, 30, 40, 50}
    std.io.println("[3] 花括号 arr[4] = ", braces[4])

    // ---- 4. 结构体字面量三种形式 ----
    Point a = Point { x: 3, y: 4 }      // 冒号
    Point b = Point { x = 5, y = 6 }    // 等号
    Point c = Point { .x = 7, .y = 8 }  // 带点
    std.io.println("[4] 冒号 x = ", a.x)
    std.io.println("[4] 等号 y = ", b.y)
    std.io.println("[4] 带点 x = ", c.x)

    // ---- 5. 整数字面量一律 i64，窄类型要显式转换 ----
    i32 narrowed = as<i32>(100)
    std.io.println("[5] 显式转换后 = ", narrowed)
}
