import std.io
import cjson
import sqlite3

# ============================================================
# pkglib 示例：组合使用 cjson(JSON) + sqlite3(数据库)
# 编译:  kaulac pkglib_demo.kl
# 依赖:  pkglib/cjson (cJSON.c), pkglib/sqlite3 (sqlite3.c)
# ============================================================

fn main() {
    println("== pkglib 示例 ==")

    # ---- cjson: 解析 JSON ----
    cJSON* root = cJSON_Parse("{\"name\":\"kaula\",\"version\":1,\"tags\":[\"lang\",\"compiler\"]}")
    if (root == null) {
        println("JSON 解析失败: ", cJSON_GetErrorPtr())
        return
    }

    cJSON* name = cJSON_GetObjectItem(root, "name")
    cJSON* version = cJSON_GetObjectItem(root, "version")
    println("name = ", cJSON_GetStringValue(name))
    println("version = ", cJSON_GetNumberValue(version))

    cJSON* tags = cJSON_GetObjectItem(root, "tags")
    i32 count = cJSON_GetArraySize(tags)
    i32 i = 0
    while (i < count) {
        cJSON* tag = cJSON_GetArrayItem(tags, i)
        println("tag[", i, "] = ", cJSON_GetStringValue(tag))
        i = i + 1
    }

    # 构建 JSON
    cJSON* out = cJSON_CreateObject()
    cJSON_AddStringToObject(out, "app", "pkglib-demo")
    cJSON_AddNumberToObject(out, "ok", 1)
    char* text = cJSON_Print(out)
    println("built json: ", text)

    # ---- sqlite3: 内存数据库 ---
    sqlite3* db = 0
    i32 op = sqlite3_open(":memory:", &db)
    if (op != 0) {
        println("打开数据库失败: ", sqlite3_errmsg(db))
        return
    }

    char* err = 0
    op = sqlite3_exec(db, "CREATE TABLE user(id INTEGER PRIMARY KEY, name TEXT);INSERT INTO user(name) VALUES ('alice');INSERT INTO user(name) VALUES ('bob');", 0, 0, &err)
    if (op != 0) {
        println("执行 SQL 失败: ", err)
        sqlite3_free(err)
    }

    sqlite3_stmt* stmt = 0
    op = sqlite3_prepare_v2(db, "SELECT id, name FROM user ORDER BY id", -1, &stmt, 0)
    bool more = op == 0
    while (more) {
        i32 steprc = sqlite3_step(stmt)
        if (steprc == 100) {
            i32 id = sqlite3_column_int(stmt, 0)
            char* nm = sqlite3_column_text(stmt, 1)
            println("user[", id, "] = ", nm)
        } else {
            more = false
        }
    }
    sqlite3_finalize(stmt)
    sqlite3_close(db)

    println("== 完成 ==")
}