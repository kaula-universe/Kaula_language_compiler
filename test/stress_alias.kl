# stress_alias.kl — 类型别名/常量压力测试
# 注意：已知解析缺陷——type 与 const 声明紧邻时 parser 会把 type 吞进
# const 值类型推断（生成 'i32const'），因此本文件用函数块隔开 type 与 const。
# 另外 type alias 为名义类型：不参与算术运算（需 as<> 显式转换）、
# bool 字面量不能赋给 alias bool、alias string 在 codegen 层映射为 char*
# （与 String 结构不兼容），本测试相应绕开这些组合。
import std.io
import std.string

# 类型别名（基础类型）
type Age = i32
type Temperature = f64
type Name = string

fn birthday(Age age) Age {
    return age
}

fn celsiusToF(Temperature c) f64 {
    return as<f64>(c) * 9.0 / 5.0 + 32.0
}

fn check(bool cond, string label) {
    if cond {
        std.io.println("PASS ", label)
    } else {
        std.io.println("FAIL ", label)
    }
}

# 常量（与 type 声明用函数隔开，规避解析缺陷）
const MAX_ITEMS = 100
const PI = 3.14159
const GREETING = "hello kaula"
const LIMIT = 200

fn main() {
    # 别名声明/传参/返回
    Age myAge = 30
    check(as<i32>(myAge) == 30, "alias declare")
    check(as<i32>(birthday(myAge)) == 30, "alias param/return")
    i32 nextAge = as<i32>(myAge) + 1
    check(nextAge == 31, "alias cast arithmetic")

    Temperature t = 100.0
    f64 f = celsiusToF(t)
    check(f == 212.0, "alias f64 math")


    # 常量
    check(MAX_ITEMS == 100, "const int")
    check(PI > 3.141 && PI < 3.142, "const float")
    check(std.string.string_equals(GREETING, std.string.string_create("hello kaula")), "const string")
    check(LIMIT == 200, "const int 2")

    # 常量参与运算
    i32 total = MAX_ITEMS + LIMIT
    check(total == 300, "const arithmetic")

    # 别名数组（[N]Type 语法）
    [3]Age ages
    ages[0] = 20
    ages[1] = 30
    ages[2] = 40
    check(as<i32>(ages[0]) + as<i32>(ages[1]) + as<i32>(ages[2]) == 90, "alias array")

    std.io.println("--- stress_alias done ---")
}
