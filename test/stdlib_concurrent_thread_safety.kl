# TDD: std.concurrent 线程 API 测试 (v2 - 修正 API 误用)
# Kaula 不支持 volatile，改用普通 i64 变量即可 (单线程测试)

import std.testing
import std.concurrent
import std.io

fn thread_noop(arg: void*) void* {
    return null
}

fn assert_msg(cond: bool, msg: string) {
    if !cond {
        std.io.println("FAIL: ", msg)
    }
}

fn main() {
    # 测试 1: 线程创建并 join
    Thread t = std.concurrent.thread_create(thread_noop, null)
    assert_msg(t != null, "thread_create 应成功")
    std.concurrent.thread_join(t)

    # 测试 2: thread_self 返回非空
    Thread me = std.concurrent.thread_self()
    assert_msg(me != null, "thread_self 应返回非空")

    # 测试 3: 同线程比较应相等
    Thread me2 = std.concurrent.thread_self()
    bool eq = std.concurrent.thread_equal(me, me2)
    assert_msg(eq, "同一线程应相等")

    # 测试 4: thread_detach 基本
    Thread t2 = std.concurrent.thread_create(thread_noop, null)
    std.concurrent.thread_detach(t2)

    # 测试 5: join null (危险)
    Thread null_t = null
    # 注释: join null 在某些实现会崩溃, 这就是 bug
    # std.concurrent.thread_join(null_t)

    # 测试 6: 重复 join (危险)
    Thread t3 = std.concurrent.thread_create(thread_noop, null)
    std.concurrent.thread_join(t3)
    # std.concurrent.thread_join(t3)  # 重复 join 应该报错

    std.io.println("thread safety tests complete")
}
