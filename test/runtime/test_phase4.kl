// 阶段四测试：conc fn + spawn 语法
// 这个文件需要编译器支持 conc fn 和 spawn 关键字

import std.runtime

// 并发函数：编译器会生成 Frame 结构体 + resume 函数
conc fn fetch_data(url: string) -> int {
    // 模拟 IO 操作
    let data = http_get(url)  // suspend 点
    return data.length
}

fn main() {
    // 顺序调用：等价于普通函数
    let result1 = fetch_data("http://example.com")
    println("Result 1: " + result1)

    // 并发调用：spawn 提交到内核
    let handle = spawn fetch_data("http://example.com/2")
    let result2 = handle.await
    println("Result 2: " + result2)
}
