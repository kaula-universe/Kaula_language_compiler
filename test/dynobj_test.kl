// dynobj test: object keyword simulates dynamic objects + encapsulation
import std.io
import std.obj

fn main() {
    // 1. object literal + field reads
    object user = object {
        name: "kaula",
        age: 3,
        score: 97.5,
        active: true,
    }

    println(object_to_string(user.name))
    println(object_to_string(user.age))
    println(object_to_string(user.score))

    // 2. dynamic field add (member write -> dynobj_set)
    user.country = "china"
    println(object_to_string(user.country))

    // 3. index access
    println(object_to_string(user["name"]))
    println(object_to_string(user["country"]))

    // 4. index write
    user["version"] = 42
    println(object_to_string(user["version"]))

    // 5. nested dynamic object
    user.config = object {
        debug: true,
        level: 2,
    }
    println(object_to_string(user.config["level"]))

    // 6. methods (lambda boxed as func object, dynobj_invoke)
    user.greet = fn(name: string) string {
        return "hello " + name
    }
    println(object_to_string(user.greet("world")))

    user.double = fn(x: int) int {
        return x * 2
    }
    println(object_to_string(user.double(21)))

    // 7. inline method in literal
    object counter = object {
        step: 5,
        add: fn(x: int) int {
            return x + 10
        },
    }
    println(object_to_string(counter.add(1)))

    // 8. empty object
    object empty = object()
    println(dynobj_size(empty))

    println("dynobj test done")
}
