// Kaula 并发内核基准
//
// 事务定义与判据见 test/bench/TRANSACTION.md。三种运行时必须跑同一个
// 事务，否则差值里会混进「工作量不同」这一项。
//
// 用法: bench.exe <curve> <concurrency> <total> [suspend_us] [degrade_pct]
// 输出: 一行 JSON，供 run_bench.py 采集。

import std.io
import std.time

// ---------- 负载常量（见 TRANSACTION.md，三边必须一致） ----------

const STEPS = 256
const SEED = 2545
const P = 9223372036854775807

// ---------- 事务 ----------

/*
 * 无分配、有真实数据依赖、工作量恒定。
 *
 * LCG 在事务内内联生成负载：*MULT 与 *31 的依赖链保证编译器不会把它
 * 折叠成常量，也不会向量化 —— 循环一定会真正跑起来。
 */
conc fn parse_and_checksum() -> i64 {
    i64 state = SEED
    i64 checksum = 0
    i64 k = 0
    while k < STEPS {
        // 64 位环绕：借 kaula_add_i64 的 wrapping 语义
        state = kaula_mul_wrap(state, 6364136223846793005)
        state = kaula_add_wrap(state, 1442695040888963407)
        i64 b = kaula_shr_u64(state, 33)
        checksum = (checksum * 31 + (b % 256)) % P
        k = k + 1
    }
    return checksum
}

// ---------- 四个曲线 ----------

// light：纯计算，无挂起。验证 conc fn 的零开销与调度器 overhead。
conc fn curve_light() -> i64 {
    return parse_and_checksum()
}

/*
 * suspend：一次 200us 挂起 + 一次计算。
 *
 * sleep 被 lowering 改写成 IoDriver 定时器请求：提交后 Worker 立刻
 * 转做别的事，不占住执行资源（I4）。
 */
conc fn curve_suspend(us: i64) -> i64 {
    std.time.time_sleep_us(us)
    return parse_and_checksum()
}

// mixed：一半带挂起，一半不带。
conc fn curve_mixed(us: i64, with_sleep: bool) -> i64 {
    if with_sleep {
        std.time.time_sleep_us(us)
    }
    return parse_and_checksum()
}

/*
 * degrade：长忙循环，不是睡眠。
 *
 * 睡会走定时器，那是 suspend 那条路。这里要的是「占住 Worker 的计算」，
 * 正是预算与停滞判定该管的东西。
 */
conc fn curve_degrade(spin_rounds: i64) -> i64 {
    i64 acc = 1
    i64 r = 0
    while r < spin_rounds {
        acc = kaula_mul_wrap(acc, 1103515245)
        acc = kaula_add_wrap(acc, 12345)
        r = r + 1
    }
    return acc ^ parse_and_checksum()
}

// ---------- 主流程 ----------

fn main() -> i32 {
    return 0
}
