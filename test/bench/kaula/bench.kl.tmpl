// Kaula 并发内核基准驱动 —— 模板
//
// 由 run_bench.py 生成：形如双 at 包裹的占位符替换成具体数值后写 bench_gen.kl 编译。
// 为什么不走命令行参数：Kaula 的参数 API 要构造 CliApp*，
// 那块语言表面尚未验证；而基准的每一个字节都必须是已验证的东西。
//
// 事务定义见 TRANSACTION.md。
//
// 输出固定格式的一行 RESULT，run_bench.py 按 key=value 解析：
//   RESULT tps=... elapsed_ns=... p50=... p95=... p99=... p999=... max=... n=... win=... errors=... checksum=...
//
// 键集与 Go/Tokio 三边完全一致，缺一个 metrics.py 就要为这个运行时
// 单开一列 N/A。
//
// 另外输出三行 PHASE，供外部采样器对齐「负载区」与「静置区」：
//   PHASE load_start  /  PHASE load_end  /  PHASE settle
// 分别在计时开始、计时结束、静置期结束后打出。

import std.io
import std.time
import std.memory

// 取「上一次 await 的服务时间」。
//
// 延迟必须由内核打点，不能由调用方掐表：并发窗口里按「调用方何时
// 取到结果」量到的是排队 + 顺序取回，与服务时间能差两个数量级。
// 修复前实测 p50=3.15s 而整轮只用 26ms —— p50 大于总耗时。
//
// 走 extern 无参访问器而不是给 await 加出参：codegen 只生成
// kaula_handle_await_into(h, &x, sizeof(x)) 一种形态，改出参会牵动
// 所有 await 的生成与 ABI；而 extern 形参里放不了 Handle。
extern fn kaula_conc_last_latency_ns() -> u64

// ---------- 事务（与 Go/Tokio 逐位一致，见 TRANSACTION.md） ----------
//
// 先 % 1048576 再乘：中间值 < 2^50。
// 先 % 1073741824 再 *31：中间值 < 2^35。
// Kaula 的乘法是检查溢出并陷阱 —— 这两处不是防御性写法，是必需写法。

conc fn parse_and_checksum() -> i64 {
    i64 state = 2545;
    i64 checksum = 0;
    i64 k = 0;
    while k < 256 {
        state = ((state % 1048576) * 1103515245 + 12345) % 9223372036854775807;
        checksum = ((checksum % 1073741824) * 31 + (state % 256)) % 9223372036854775807;
        k = k + 1;
    }
    return checksum;
}

// ---------- 四个曲线 ----------

// light：纯计算，无挂起。验证 conc fn 零开销与调度器 overhead。
conc fn curve_light() -> i64 {
    return parse_and_checksum();
}

// suspend：一次挂起 + 一次计算。sleep 被 lowering 改写成 IoDriver
// 定时器请求，提交后 Worker 立刻转做别的事（I4）。
conc fn curve_suspend() -> i64 {
    std.time.time_sleep_us(@@SUSPEND_US@@);
    return parse_and_checksum();
}

// mixed：@@MIXED_SLEEP_PCT@@% 的任务带挂起。
conc fn curve_mixed(with_sleep: bool) -> i64 {
    if with_sleep {
        std.time.time_sleep_us(@@SUSPEND_US@@);
    }
    return parse_and_checksum();
}

// degrade：@@DEGRADE_PCT@@% 的任务是长忙循环。
// 忙循环而不是睡眠 —— 睡会走定时器，那是 suspend 那条路。
// 这里要的是「占住 Worker 的计算」，正是预算与停滞判定该管的东西。
conc fn curve_degrade(spin_rounds: i64) -> i64 {
    i64 acc = 1;
    i64 r = 0;
    while r < spin_rounds {
        acc = ((acc % 1073741824) * 1103515245 + 12345) % 9223372036854775807;
        r = r + 1;
    }
    return acc ^ parse_and_checksum();
}

// ---------- 分位数 ----------

// ---------- 主流程 ----------

fn main() -> i32 {
    i64 total = @@TOTAL@@;
    i64 win = @@CONC@@;

    // 预热：首轮含线程首次调度与缓存冷启动，不计入
    Handle hw = spawn curve_light();
    i64 vw = hw.await;
    if vw != 13356499072 {
        std.io.println("BENCH_ERROR warmup checksum ", vw);
        return 1;
    }

    // 这条曲线的期望值：degrade 走 acc^parse 路径，与上面纯 parse 不同。
    // 与 Go/Tokio 一致 —— 两边也是在计时区之外先跑一次拿 expected。
    Handle he = @@EXPECTED@@;
    i64 expected = he.await;

    // 延迟样本：内核打点的 submit -> complete 服务时间（见文件头注释）
    [@@MAX_SAMPLES@@]i64 lat;
    i64 n = 0;
    i64 checksum = 0;
    i64 errors = 0;

    i64 issued = 0;
    i64 done = 0;

    // 在途句柄窗口：最多 win 个。
    // 堆分配：KaulaHandle 含 ABI 预留字段（48B），win 窗口栈数组会超
    // 编译器 256KB 栈预算（static assert 拒绝）；堆分配与 Go 的
    // slice（堆）对等，且不改变窗口语义。KMM scope 退出自动回收。
    Handle* in_flight = as<Handle*>(std.memory.kmm_v4_alloc(@@MAX_CONC@@ * 48))

    std.io.println("PHASE load_start");
    i64 t0 = std.time.time_now_ns();

    // 窗口式：先填满 win 个在途，再逐个 await。
    //
    // 为什么不逐个「提交-等-提交」串行：那测的是单任务往返延迟，
    // 根本没有并发在飞，TPS 会低一个数量级。
    //
    // 为什么不按大批量提交后统一等：那样批边界会形成同步点，
    // 测出来的是「批」的吞吐而不是调度的吞吐。
    //
    // 延迟由内核打点（submit -> complete），与取回顺序无关。
    while done < total {
        // 1) 填窗口
        i64 j = 0;
        while j < win {
            // Kaula 不支持 &&，用嵌套 if 表达「两条件同时成立」。
            if issued >= total {
                break;
            }
            @@SUBMIT@@;
            issued = issued + 1;
            j = j + 1;
        }
        i64 filled = j;

        // 2) 逐个取回
        j = 0;
        while j < filled {
            i64 r = in_flight[j].await;
            // 服务时间由内核记录（submit -> complete），与取回顺序无关
            i64 svc = kaula_conc_last_latency_ns();
            // 累加器必须三边同式且都不溢出。原来的 (checksum + r) % P 在
            // degrade 上必溢出：r ≈ 9.8e18，第 10 次累加就越过有符号 64 位。
            // Go/Rust 静默回绕，Kaula 的乘加是检查溢出并陷阱 —— 同一行代码
            // 三个目标语义不同，Kaula 直接 KAULA FATAL 退出。
            // 改成滚动散列：先把两边压到 2^30，最大中间值 32*(2^30-1) < 2^35，
            // 远离 2^63。与事务本体用的是同一种写法。
            checksum = ((checksum % 1073741824) * 31 + (r % 1073741824)) % 9223372036854775807;
            if r != expected {
                errors = errors + 1;
            }
            if n < @@MAX_SAMPLES@@ {
                lat[n] = svc;
                n = n + 1;
            }
            done = done + 1;
            j = j + 1;
        }
    }

    i64 elapsed = std.time.time_now_ns() - t0;

    // 静置期：给运行时一点时间回收，之后才测 RSS 回落。
    // 与 Go 的 time.Sleep / Tokio 的 sleep 对齐 —— 400ms 同一个数。
    std.io.println("PHASE load_end");
    std.time.time_sleep_us(400000);
    std.io.println("PHASE settle");

    // 分位数在计时区之外算：排序本身不该污染被测量的时间
    i64 p50 = 0;
    i64 p95 = 0;
    i64 p99 = 0;
    i64 p999 = 0;
    i64 mx = 0;
    if n > 0 {
        // 就地选择排序：n <= 2000，O(n^2) 在计时区外跑，代价可忽略。
        // 不用「数组作函数参数」的 helper —— 那条路径会生成非法 C。
        i64 a = 0;
        while a < n {
            i64 b = a + 1;
            while b < n {
                if lat[b] < lat[a] {
                    i64 tmp = lat[a];
                    lat[a] = lat[b];
                    lat[b] = tmp;
                }
                b = b + 1;
            }
            a = a + 1;
        }
        // 下标公式 (n*pct)/100 与 Go 的 percentile 逐字一致；p999 用 /1000。
        // 上界夹到 n-1：Go 侧同位置有夹，这里 n 很小时两边才不会分叉。
        p50 = lat[(n * 50) / 100];
        p95 = lat[(n * 95) / 100];
        p99 = lat[(n * 99) / 100];
        p999 = lat[(n * 999) / 1000];
        if (n * 999) / 1000 >= n {
            p999 = lat[n - 1];
        }
        mx = lat[n - 1];
    }

    // 输出固定格式的一行，run_bench.py 按 key=value 解析。
    // 写成单行：多行调用与自动补分号的脚本会互相干扰。
    //
    // inlined：本曲线的事务函数是否被编译器完全内联。
    //   不含挂起点的 conc fn（light/degrade）会被 lowering 成
    //   `{ i64 __r = K_xxx_as_fn(); kaula_handle_complete(__r); }` ——
    //   既不分配 Frame 也不进内核，所以内核的 submit/complete 打点
    //   根本不会发生，上面的 p50..max 全为 0。
    //   这不是「测不到」，是「编译器把这个任务优化没了」——
    //   用户拿到的是零调度开销，代价是内核看不到它的服务时间。
    //   inlined=1 时延迟列请对照 C 边（cbench，恒 inlined=0）读，
    //   不要当成「延迟为 0」。
    std.io.println("RESULT curve=@@CURVE@@ tps=", (total * 1000000000) / elapsed, " elapsed_ns=", elapsed, " p50=", p50, " p95=", p95, " p99=", p99, " p999=", p999, " max=", mx, " n=", n, " win=", win, " errors=", errors, " checksum=", checksum, " inlined=@@INLINED@@");
    return 0;
}
