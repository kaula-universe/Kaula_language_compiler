// MoonBit 自然形态：Array[Planet] 栈上小数组 + Double.sqrt()。
// 与 ../kaula/nbody.kl 算法逐行对应，输出用 fmt9.mbt 的精确 "%.9f"（与 C printf 对齐）。

///|
const PI : Double = 3.141592653589793

///|
const DAYS_PER_YEAR : Double = 365.24

///|
struct Planet {
  mut x : Double
  mut y : Double
  mut z : Double
  mut vx : Double
  mut vy : Double
  mut vz : Double
  mass : Double
}

///|
fn advance(bodies : Array[Planet], dt : Double) -> Unit {
  let nb = bodies.length()
  for i = 0; i < nb; i = i + 1 {
    for j = i + 1; j < nb; j = j + 1 {
      let dx = bodies[i].x - bodies[j].x
      let dy = bodies[i].y - bodies[j].y
      let dz = bodies[i].z - bodies[j].z
      let distance = (dx * dx + dy * dy + dz * dz).sqrt()
      let mag = dt / (distance * distance * distance)
      bodies[i].vx = bodies[i].vx - dx * bodies[j].mass * mag
      bodies[i].vy = bodies[i].vy - dy * bodies[j].mass * mag
      bodies[i].vz = bodies[i].vz - dz * bodies[j].mass * mag
      bodies[j].vx = bodies[j].vx + dx * bodies[i].mass * mag
      bodies[j].vy = bodies[j].vy + dy * bodies[i].mass * mag
      bodies[j].vz = bodies[j].vz + dz * bodies[i].mass * mag
    }
  }
  for k = 0; k < nb; k = k + 1 {
    bodies[k].x = bodies[k].x + dt * bodies[k].vx
    bodies[k].y = bodies[k].y + dt * bodies[k].vy
    bodies[k].z = bodies[k].z + dt * bodies[k].vz
  }
}

///|
fn energy(bodies : Array[Planet]) -> Double {
  let nb = bodies.length()
  let mut e = 0.0
  for i = 0; i < nb; i = i + 1 {
    e = e + 0.5 * bodies[i].mass * (bodies[i].vx * bodies[i].vx + bodies[i].vy * bodies[i].vy + bodies[i].vz * bodies[i].vz)
    for j = i + 1; j < nb; j = j + 1 {
      let dx = bodies[i].x - bodies[j].x
      let dy = bodies[i].y - bodies[j].y
      let dz = bodies[i].z - bodies[j].z
      let distance = (dx * dx + dy * dy + dz * dz).sqrt()
      e = e - (bodies[i].mass * bodies[j].mass) / distance
    }
  }
  e
}

///|
fn offset_momentum(bodies : Array[Planet], solar_mass : Double) -> Unit {
  let nb = bodies.length()
  let mut px = 0.0
  let mut py = 0.0
  let mut pz = 0.0
  for i = 0; i < nb; i = i + 1 {
    px = px + bodies[i].vx * bodies[i].mass
    py = py + bodies[i].vy * bodies[i].mass
    pz = pz + bodies[i].vz * bodies[i].mass
  }
  bodies[0].vx = -px / solar_mass
  bodies[0].vy = -py / solar_mass
  bodies[0].vz = -pz / solar_mass
}

///|
fn make_bodies() -> Array[Planet] {
  let solar_mass = 4.0 * PI * PI
  let dpy = DAYS_PER_YEAR
  let bodies = Array::make(5, { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: 0.0 })
  bodies[0] = { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: solar_mass }
  bodies[1] = { x: 4.84143144246472090e+00, y: -1.16032004402742839e+00, z: -1.03622044471123109e-01,
                vx: 1.66007664274403694e-03*dpy, vy: 7.69901118419740425e-03*dpy, vz: -6.90460016972063023e-05*dpy,
                mass: 9.54791938424326609e-04*solar_mass }
  bodies[2] = { x: 8.34336671824457987e+00, y: 4.12479856412430479e+00, z: -4.03523417114321381e-01,
                vx: -2.76742510726862411e-03*dpy, vy: 4.99852801234917238e-03*dpy, vz: 2.30417297573763929e-05*dpy,
                mass: 2.85885980666130812e-04*solar_mass }
  bodies[3] = { x: 1.28943695621391310e+01, y: -1.51111514016986312e+01, z: -2.23307578892655734e-01,
                vx: 2.96460137564761618e-03*dpy, vy: 2.37847173959480950e-03*dpy, vz: -2.96589568540237556e-05*dpy,
                mass: 4.36624404335156298e-05*solar_mass }
  bodies[4] = { x: 1.53796971148509165e+01, y: -2.59193146099879611e+01, z: 1.79258772950371181e-01,
                vx: 2.68067772490389322e-03*dpy, vy: 1.62824170038242295e-03*dpy, vz: -9.51592254519715870e-05*dpy,
                mass: 5.15138902046611451e-05*solar_mass }
  offset_momentum(bodies, solar_mass)
  bodies
}

///|
fn main {
  let n_steps = N_STEPS_PLACEHOLDER
  let bodies = make_bodies()
  println(format_fixed_point(energy(bodies), 9))
  for i = 0; i < n_steps; i = i + 1 { advance(bodies, 0.01) }
  println(format_fixed_point(energy(bodies), 9))
}
