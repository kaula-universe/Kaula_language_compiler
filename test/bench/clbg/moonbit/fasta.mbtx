// MoonBit 自然形态：Array[Char] 累积输出 + String::from_array 一次输出。
// 与 ../kaula/fasta.kl 算法逐行对应（LCG + 累积概率 + 二分加权选择）。

///|
const IM : Int64 = 139968L

///|
const IA : Int64 = 3877L

///|
const IC : Int64 = 29573L

///|
struct Amino {
  c : Char
  mut p : Double
}

///|
fn gen_random(last : Ref[Int64], max : Double) -> Double {
  last.val = (last.val * IA + IC) % IM
  return max * last.val.to_double() / IM.to_double()
}

///|
fn make_cumulative(list : Array[Amino]) -> Unit {
  let mut cp = 0.0
  for i = 0; i < list.length(); i = i + 1 {
    cp = cp + list[i].p
    list[i].p = cp
  }
}

///|
fn select_random(list : Array[Amino], last : Ref[Int64]) -> Char {
  let r = gen_random(last, 1.0)
  if r < list[0].p { return list[0].c }
  let mut lo = 0
  let mut hi = list.length() - 1
  while hi > lo + 1 {
    let i = (hi + lo) / 2
    if r < list[i].p { hi = i } else { lo = i }
  }
  list[hi].c
}

///|
fn put_str(out : Array[Char], s : String) -> Unit {
  let n = s.length()
  for i = 0; i < n; i = i + 1 {
    out.push(s[i].to_int().to_char().unwrap())
  }
}

///|
fn make_repeat_fasta(s : String, n : Int, out : Array[Char]) -> Unit {
  let kn = s.length()
  let mut pos = 0
  let mut todo = n
  while todo > 0 {
    let line = if todo < 60 { todo } else { 60 }
    for k = 0; k < line; k = k + 1 {
      out.push(s[(pos + k) % kn].to_int().to_char().unwrap())
    }
    out.push('\n')
    pos = pos + line
    if pos >= kn { pos = pos - kn }
    todo = todo - line
  }
}

///|
fn make_random_fasta(list : Array[Amino], n : Int, last : Ref[Int64], out : Array[Char]) -> Unit {
  let mut todo = n
  while todo > 0 {
    let line = if todo < 60 { todo } else { 60 }
    for k = 0; k < line; k = k + 1 {
      out.push(select_random(list, last))
    }
    out.push('\n')
    todo = todo - line
  }
}

///|
const ALU = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGGGAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGACCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAATACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCAGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGGAGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCCAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA"

///|
fn main {
  let n = N_PLACEHOLDER
  let iub = [
    { c: 'a', p: 0.27 }, { c: 'c', p: 0.12 }, { c: 'g', p: 0.12 }, { c: 't', p: 0.27 },
    { c: 'B', p: 0.02 }, { c: 'D', p: 0.02 }, { c: 'H', p: 0.02 }, { c: 'K', p: 0.02 },
    { c: 'M', p: 0.02 }, { c: 'N', p: 0.02 }, { c: 'R', p: 0.02 }, { c: 'S', p: 0.02 },
    { c: 'V', p: 0.02 }, { c: 'W', p: 0.02 }, { c: 'Y', p: 0.02 },
  ]
  let homo = [
    { c: 'a', p: 0.3029549426680 }, { c: 'c', p: 0.1979883004921 },
    { c: 'g', p: 0.1975473066391 }, { c: 't', p: 0.3015094502008 },
  ]
  make_cumulative(iub)
  make_cumulative(homo)
  let last : Ref[Int64] = { val: 42L }
  let out : Array[Char] = []
  put_str(out, ">ONE Homo sapiens alu\n")
  make_repeat_fasta(ALU, n * 2, out)
  put_str(out, ">TWO IUB ambiguity codes\n")
  make_random_fasta(iub, n * 3, last, out)
  put_str(out, ">THREE Homo sapiens frequency\n")
  make_random_fasta(homo, n * 5, last, out)
  // 按行输出：每次 println 一行（~60 字节），避免单次大字符串导致 native abort
  let mut start = 0
  let mut j = 0
  while j < out.length() {
    if out[j] == '\n' {
      let chars = out[start:j].to_owned()
      println(String::from_array(chars))
      start = j + 1
    }
    j = j + 1
  }
}
