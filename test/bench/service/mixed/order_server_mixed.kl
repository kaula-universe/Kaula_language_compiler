// Kaula 混合压测服务 —— 每请求 spawn 计算子任务 + await 结果
// 混合原语：conc fn（conn_task + compute）、spawn、await、IO（read/write）
import std.io
import std.memory
import std.time

extern fn kaula_svc_listen(port: i32) -> i32
extern fn kaula_svc_accept(lfd: i32) -> i32
extern fn kaula_tls_io_result() -> i32
extern fn kaula_close(fd: i32) -> i32
extern fn net_recv(fd: i32, buf: *u8, len: i32) -> i64
extern fn net_send(fd: i32, buf: *u8, len: i32) -> i64

// 计算子任务：checksum256（256 轮 FNV）+ 价格派生
// 接受 seq 和 salt，返回编码后的结果（低 32 位 checksum，高 32 位 seq*price）
conc fn compute_task(seq: i32, salt: u32) -> u64 {
    u32 h = 0x811C9DC5
    // 4x 循环展开：外层 64 次，每次 4 轮 FNV，减少 range 迭代器开销
    for round in range(64) {
        h = (h ^ salt) * 16777619 + as<u32>(round * 4)
        h = (h ^ salt) * 16777619 + as<u32>(round * 4 + 1)
        h = (h ^ salt) * 16777619 + as<u32>(round * 4 + 2)
        h = (h ^ salt) * 16777619 + as<u32>(round * 4 + 3)
    }
    i32 price = (seq * 37 + 99) % 10000
    u64 result = (as<u64>(h) & 0xFFFFFFFF) | (as<u64>(price) << 32)
    return result
}

// 顶层包装：spawn+await 在非守卫模式下类型推断正常
conc fn compute_spawn_await(seq: i32, salt: u32) -> u64 {
    Handle h = spawn compute_task(seq, salt)
    u64 r = h.await
    return r
}

fn itoa(v: i32, out: *u8, base: i32) -> i32 {
    i32 t = v
    i32 nd = 1
    while (t >= 10) { t = t / 10; nd = nd + 1 }
    i32 p = base + nd - 1
    t = v
    while (t > 0) {
        out[p] = 48 + (t % 10)
        t = t / 10
        p = p - 1
    }
    return nd
}

conc fn conn_task(fd: i32) -> i32 {
    u8* buf = std.memory.kmm_v4_alloc(1024)
    u8* resp = std.memory.kmm_v4_alloc(128)
    while (true) {
        net_recv(fd, buf, 1024)
        i32 got = kaula_tls_io_result()
        if (got <= 0) {
            kaula_close(fd)
            return 0
        }
        i32 off = 0
        while (off < got) {
            i32 n = 0
            while (off + n < got && buf[off + n] != 10) { n = n + 1 }
            if (off + n >= got) { break }
            // 解析 seq（第 2 字段）
            i32 i = 2
            i32 seq = 0
            while (i < n && buf[off + i] != 44) {
                seq = seq * 10 + (buf[off + i] - 48)
                i = i + 1
            }
            // 取行首字节作为 salt
            u32 salt = as<u32>(buf[off])
            // ★ 混合核心：spawn 计算子任务 + await（通过顶层包装避开守卫模式类型推断）
            u64 computed = compute_spawn_await(seq, salt)
            u32 ck = as<u32>(computed & 0xFFFFFFFF)
            i32 price = as<i32>(computed >> 32)
            // 构造响应：R,seq,cklow,price\n
            resp[0] = 82
            resp[1] = 44
            i32 pos = itoa(seq, resp, 2)
            pos = pos + 2
            resp[pos] = 44
            pos = pos + 1
            i32 cklow = as<i32>(ck % 256)
            pos = itoa(cklow, resp, pos) + pos
            resp[pos] = 44
            pos = pos + 1
            pos = itoa(price, resp, pos) + pos
            resp[pos] = 10
            pos = pos + 1
            net_send(fd, resp, pos)
            off = off + n + 1
        }
    }
    kaula_close(fd)
    return 0
}

fn main() -> i32 {
    i32 lfd = kaula_svc_listen(8130)
    if (lfd < 0) {
        std.io.println("listen failed")
        return 1
    }
    std.io.println("kl mixed server on 8130")
    while (true) {
        i32 cfd = kaula_svc_accept(lfd)
        if (cfd >= 0) {
            spawn conn_task(cfd)
        }
    }
    return 0
}
