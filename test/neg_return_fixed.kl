# 负面：call 内提前 return（应报错）
import std.io
fn main() {
    auto items = [10, 20, 30]
    int total = 0
    spend(items) {
        call(1) {
            return
        }
        call(2) {
            total = total + items[1]
        }
        call(3) {
            total = total + items[2]
        }
    }
}