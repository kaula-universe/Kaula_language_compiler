// 回归：结构宏多规则按实参结构分派（Task #1）。
//
// 一个前缀名定义多条 #[prefix] fn，每条用不同的 tree(...) 签名声明它接受的
// 实参结构；展开时按声明顺序选择第一条所有约束都命中的规则。
// 这个文件同时验证多规则不会生成同名 C 函数（否则 clang: conflicting types）。

#[prefix]
fn Shape(tree(identifier), x) {
    println("identifier: ", $x)
}

#[prefix]
fn Shape(tree(literal), x) {
    println("literal: ", $x)
}

#[prefix]
fn Shape(tree(binary), x) {
    println("binary: ", $x)
}

#[prefix]
fn Shape(tree(call), x) {
    println("call: ", $x)
}

// 无约束规则作兜底：带约束的规则都不命中时才选中它
#[prefix]
fn Shape(x) {
    println("fallback: ", $x)
}

// 普通函数：作为 call 类实参，验证按结构分派能识别调用形态
fn twice(x: i64) -> i64 {
    return x * 2
}

fn main() {
    i64 a = 10
    @Shape(x = a)
    @Shape(x = 42)
    @Shape(x = a + 1)
    @Shape(x = twice(a))
    @Shape(x = "str")
    println("shape dispatch ok")
}
