// Kaula 内存密集场景基准：与 C++ 版本逐场景等价对比（release/-O3）
// 内存模型：SOR 自动管理（循环尾 offset_restore 回卷 TLAB、函数出口 per-object 回收），
// 不手动 free——显式 kmm_v4_free 会与编译器自动回收冲突。
import std.memory
import std.time
import std.io

struct Node {
    next: i64
    value: i64
}

// 场景 A：小对象分配/使用吞吐（30 轮 × 20 万次 64B，TLAB 循环回卷）
fn bench_churn() {
    i64 rounds = 30
    i64 count = 200000
    i64 acc = 0
    i64 t0 = std.time.time_now_ms()
    i64 r = 0
    while r < rounds {
        i64 i = 0
        while i < count {
            i64* p = std.memory.kmm_v4_alloc(64)
            p[0] = i
            acc += p[0]
            i += 1
        }
        r += 1
    }
    i64 t1 = std.time.time_now_ms()
    std.io.println("[A] churn_small      ", t1 - t0, " ms   acc=", acc)
}

// 场景 B：200 万节点索引链（32MB），构建 + 顺序遍历（出口自动回收）
fn bench_chain() {
    i64 n = 2000000
    i64 acc = 0
    i64 t0 = std.time.time_now_ms()
    Node* nodes = std.memory.kmm_v4_alloc(n * 16)
    i64 i = 0
    while i < n {
        nodes[i].value = i
        if i + 1 < n {
            nodes[i].next = i + 1
        } else {
            nodes[i].next = -1
        }
        i += 1
    }
    i64 cur = 0
    i64 steps = 0
    while cur >= 0 && steps < n {
        acc += nodes[cur].value
        cur = nodes[cur].next
        steps += 1
    }
    i64 t1 = std.time.time_now_ms()
    std.io.println("[B] chain_2M         ", t1 - t0, " ms   acc=", acc)
}

// 场景 C：800 万 i64 数组（64MB）写入 + LCG 随机读 2000 万次（出口自动回收）
fn bench_rand() {
    i64 n = 8000000
    i64 reads = 20000000
    i64 acc = 0
    i64 t0 = std.time.time_now_ms()
    i64* arr = std.memory.kmm_v4_alloc(n * 8)
    i64 i = 0
    while i < n {
        arr[i] = i
        i += 1
    }
    i64 seed = 12345
    i64 j = 0
    while j < reads {
        seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
        acc += arr[seed & (n - 1)]
        j += 1
    }
    i64 t1 = std.time.time_now_ms()
    std.io.println("[C] rand_64MB        ", t1 - t0, " ms   acc=", acc)
}

// 场景 D：8 × 8MB 大对象生命周期（64MB），写入+读校验（出口自动回收）
fn bench_lifetime() {
    i64 blocks = 8
    i64 per = 8000000
    i64 acc = 0
    i64 t0 = std.time.time_now_ms()
    i64 b = 0
    while b < blocks {
        i64* arr = std.memory.kmm_v4_alloc(per * 8)
        i64 i = 0
        while i < per {
            arr[i] = b * per + i
            i += 1
        }
        i64 j = 0
        while j < 1000 {
            acc += arr[j * 8000]
            j += 1
        }
        b += 1
    }
    i64 t1 = std.time.time_now_ms()
    std.io.println("[D] lifetime_8x8MB   ", t1 - t0, " ms   acc=", acc)
}

fn main() {
    std.io.println("=== Kaula KMM v4 内存密集基准 (release/-O3) ===")
    bench_churn()
    bench_chain()
    bench_rand()
    bench_lifetime()
}
