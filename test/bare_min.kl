// 裸机冒烟测试：无 libc、无 OS，仅 freestanding 库
import freestanding.memory
import freestanding.string
import freestanding.math
import freestanding.io

fn main() {
    char* buf = as<char*>(fs_alloc(64))
    memset(buf, 65, 8)
    i32 r = as<i32>(buf[0]) + as<i32>(buf[3])
    char* num = as<char*>(fs_alloc(16))
    fs_itoa(as<i64>(r), num)
    i64 parsed = fs_atoi(num)
    i32 total = as<i32>(parsed) + math_abs_i32(-7)
    // total == 130 + 7 == 137
    if total == 137 {
        fs_alloc_reset()
        total = math_round_up(1, 1)
    }
}
