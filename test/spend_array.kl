# Spend/Call 强制消费流测试
import std.io
fn main() {
    auto items = [10, 20, 30]
    int total = 0
    spend(items) {
        call(1) {
            total = total + items[0]
        }
        call(2) {
            total = total + items[1]
        }
        call(3) {
            total = total + items[2]
        }
    }
    if total == 60 {
        println("spend array OK")
    } else {
        println("spend array FAIL: ", total)
    }
}
