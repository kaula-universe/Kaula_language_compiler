import std.memory
import std.io

// 采样统计：max / avg / median（插入排序）
pub fn sort_i64(i64* a, i64 n) {
    i64 i = 1
    while i < n {
        i64 key = a[i]
        i64 j = i - 1
        while j >= 0 && a[j] > key {
            a[j + 1] = a[j]
            j -= 1
        }
        a[j + 1] = key
        i += 1
    }
}

pub fn report(i64* s, i64 n, string name) {
    i64 mx = s[0]
    i64 sum = 0
    i64 i = 0
    while i < n {
        if s[i] > mx {
            mx = s[i]
        }
        sum += s[i]
        i += 1
    }
    sort_i64(s, n)
    i64 med = 0
    if n % 2 == 1 {
        med = s[n / 2]
    } else {
        med = (s[n / 2 - 1] + s[n / 2]) / 2
    }
    i64 avg = sum / n
    std.io.println("  [MEM] ", name, "  peak=", mx, "  avg=", avg, "  median=", med)
}
