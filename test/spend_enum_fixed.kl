# 正例：枚举模式强制消费（应通过）
# 说明：spend(c) 编译期证明穷尽性，运行时只执行匹配的分支
import std.io
enum Color {
    Red, Green, Blue
}
fn main() {
    Color c = Color.Red
    int seen = 0
    spend(c) {
        call(Red) { seen = seen + 1 }
        call(Green) { seen = seen + 2 }
        call(Blue) { seen = seen + 3 }
    }
    # 只执行 Red 分支，seen 应为 1
    if seen == 1 {
        println("enum spend OK")
    } else {
        println("enum spend FAIL")
    }
}