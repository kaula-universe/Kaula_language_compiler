# leak_writeonly.kl —— 写穿但不推进游标（cur.next = nd，游标停在原地）
#
# 这个形态当前不泄漏（无 promote 发射）。固化成用例的意义是钉住
# 「写穿本身不释放容器」这条正确语义：修复不得为了让本形态回收
# 而对容器发射 survivor_free —— 那会释放容器指向的整个对象，
# 紧接着的 cur.next = nd 直接变成 use-after-free。

import std.io
import std.memory

struct Node {
    value: i64
    next: i64
}

fn write_only(i64 n) i64 {
    Node* cur = std.memory.kmm_v4_alloc(16)
    cur.value = -1
    cur.next = -1
    i64 i = 0
    while i < n {
        Node* nd = std.memory.kmm_v4_alloc(16)
        nd.value = i
        nd.next = -1
        cur.next = as<i64>(nd)
        i += 1
    }
    return cur.next
}

fn check(bool cond, string label) {
    if !cond {
        std.io.println("FAIL ", label)
    }
}

fn main() {
    i64 n = 2000
    i64 rounds = 50

    i64 last = write_only(n)
    check(last != -1 && last != 0, "write_only produced tail pointer")
    i64 after1 = std.memory.kmm_v4_total_usage()

    i64 r = 1
    while r < rounds {
        write_only(n)
        r += 1
    }
    i64 afterN = std.memory.kmm_v4_total_usage()

    i64 growth = afterN - after1
    std.io.println("[leak_writeonly] after1=", after1, " afterN=", afterN, " growth=", growth)
    check(growth < 65536, "write-only watermark does not grow with rounds")

    std.io.println("PASS leak_writeonly")
}
