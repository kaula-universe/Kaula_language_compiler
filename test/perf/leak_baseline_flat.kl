# leak_baseline_flat.kl —— 对照组：无容器、无写穿、无 promote 的纯 churn
#
# 对照组的意义：它证明 KMM 的作用域回收（TLAB bump + scope_pop）本身是对的。
# 任何 P0 修复都不得让它退化——若本用例的水位开始增长，说明修复把
# 普通作用域回收也一起破坏了。

import std.io
import std.memory

fn churn(i64 n) i64 {
    i64 s = 0
    i64 i = 0
    while i < n {
        i64* p = std.memory.kmm_v4_alloc(16)
        p[0] = i
        s += p[0]
        i += 1
    }
    return s
}

fn check(bool cond, string label) {
    if !cond {
        std.io.println("FAIL ", label)
    }
}

fn main() {
    i64 n = 2000
    i64 rounds = 50

    i64 expect = 0
    i64 i = 0
    while i < n {
        expect += i
        i += 1
    }

    i64 s0 = churn(n)
    check(s0 == expect, "flat churn sum")
    i64 after1 = std.memory.kmm_v4_total_usage()

    i64 r = 1
    while r < rounds {
        churn(n)
        r += 1
    }
    i64 afterN = std.memory.kmm_v4_total_usage()

    i64 growth = afterN - after1
    std.io.println("[leak_baseline_flat] after1=", after1, " afterN=", afterN, " growth=", growth)
    check(growth < 65536, "flat churn watermark does not grow with rounds")

    std.io.println("PASS leak_baseline_flat")
}
