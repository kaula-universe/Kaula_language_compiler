// codegen_plus_chain_scale.kl — 编译器长加法链的端到端护栏。
//
// 背景：generateBinaryExpression 先算好 left/right，随后 PLUS 分支却把它们
// 丢掉、在 generatePlusOperation 里对两棵子树各再生成一次。每棵子树被生成
// 两次，递归下去 T(n)=2·T(n-1)：实测 -release 下 28 项就要 86.94s，
// 40 项约 44 小时，60 项超出宇宙年龄。修复后是线性，40 项 0.2s。
//
// 这道用例把 40 项左结合 + 链放进默认测试集：一旦重复生成回归，编译必然
// 撞上 run_tests.py 的 180s 超时，护栏立刻亮红灯。
//
// 同理，重复生成也会让生成出来的 C 里每个操作数出现指数次——体量上同样
// 不可编译，所以"能编出来"本身就同时守住了两条退化路径。
import std.io

fn main() {
    i64 s = 0
    s = as<i64>(0) + as<i64>(1) + as<i64>(2) + as<i64>(3) + as<i64>(4) + as<i64>(5) + as<i64>(6) + as<i64>(7) + as<i64>(8) + as<i64>(9) + as<i64>(10) + as<i64>(11) + as<i64>(12) + as<i64>(13) + as<i64>(14) + as<i64>(15) + as<i64>(16) + as<i64>(17) + as<i64>(18) + as<i64>(19) + as<i64>(20) + as<i64>(21) + as<i64>(22) + as<i64>(23) + as<i64>(24) + as<i64>(25) + as<i64>(26) + as<i64>(27) + as<i64>(28) + as<i64>(29) + as<i64>(30) + as<i64>(31) + as<i64>(32) + as<i64>(33) + as<i64>(34) + as<i64>(35) + as<i64>(36) + as<i64>(37) + as<i64>(38) + as<i64>(39)
    // 0+1+...+39 = 780
    if s != 780 {
        std.io.println("FAIL codegen_plus_chain_scale: sum=", s)
    }
}
