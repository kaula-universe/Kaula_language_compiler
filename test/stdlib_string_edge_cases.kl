#[test]
fn test_string_memory_leak() {
    # 内存: 大量字符串创建销毁
    for i in range(0, 1000) {
        string temp = std.string.create("temp string with some length")
        string upper = std.string.to_upper(temp)
        string concat = std.string.concat(temp, upper)
        # 期望 KMM 正确回收
    }
    # 没有崩溃就算通过
}

