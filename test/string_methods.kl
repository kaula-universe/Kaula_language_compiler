import std.io
import std.string

# 字符串方法形式回归语料
#
# 对应缺陷（此前前端全部放行、C 侧才炸）：
#   1. String.length()   → 生成 Object_length(s)，符号在 std/ 中不存在 → 链接失败
#   2. string.length()   → 生成 string_object_length(String)，形参是 StringObject* → C 类型错
#   3. String.substring(a, b) → 生成 Object_substring(s, 1, 2)，符号不存在 → C 编译失败
#   4. extract s[i]      → String 在 C 层是 SSO 结构体，不是可下标数组
#                           → "subscripted value is neither array nor pointer nor vector"
#                           （已改为前端语义错误，见本目录外围的负向用例说明）

fn main() i32 {
    String s = std.string.create("abc")
    if s.length() != 3 {
        std.io.println("FAIL: String.length()")
        return 1
    }

    string cs = "abcdef"
    if cs.length() != 6 {
        std.io.println("FAIL: string.length()")
        return 2
    }

    String t = s.substring(1, 3)
    if std.string.compare(t, std.string.create("bc")) != 0 {
        std.io.println("FAIL: String.substring(1, 3)")
        return 3
    }

    String u = cs.substring(0, 2)
    if std.string.compare(u, std.string.create("ab")) != 0 {
        std.io.println("FAIL: string.substring(0, 2)")
        return 4
    }

    String empty = std.string.create("")
    if empty.length() != 0 {
        std.io.println("FAIL: empty length")
        return 5
    }

    # 方法形式与扁平 std 函数必须等价
    if s.substring(0, 2).length() != 2 {
        std.io.println("FAIL: chain substring().length()")
        return 6
    }

    # String + 方法调用结果：曾被推断成 int → string_concat_int（C 类型错）
    String joined = s.substring(0, 2) + s.substring(2, 3)
    if std.string.compare(joined, std.string.create("abc")) != 0 {
        std.io.println("FAIL: String + substring(...)")
        return 7
    }

    std.io.println("string methods ok")
    return 0
}
