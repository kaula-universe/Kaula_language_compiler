import std.io;

fn main() i32 {
    i32 x = 2;
    i32 y = 3;

    # 1. 不同变量的链: 不警告
    if (x == 1) {
        std.io.println("a");
    } else if (y == 2) {
        std.io.println("b");
    }

    # 2. 非 == 比较: 不警告
    if (x > 1) {
        std.io.println("c");
    } else if (x < 5) {
        std.io.println("d");
    }

    # 3. 只有 if 无 else if: 不警告
    if (x == 1) {
        std.io.println("e");
    }

    # 4. 链中途换变量: 不警告 (x, y, x)
    if (x == 1) {
        std.io.println("f");
    } else if (y == 2) {
        std.io.println("g");
    } else if (x == 3) {
        std.io.println("h");
    }

    # 5. 连续单变量 == 链: 警告
    if (x == 1) {
        std.io.println("i");
    } else if (x == 2) {
        std.io.println("j");
    }

    # 6. 嵌套在函数内更深层: 警告
    if (x == 1) {
        if (y == 2) {
            std.io.println("k");
        } else if (y == 3) {
            std.io.println("l");
        }
    }

    return 0;
}
