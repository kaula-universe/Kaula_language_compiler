// 场景 C：64MB 数组写入 + LCG 随机读 2000 万次，分配前/中/后采样
import std.memory
import std.time
import std.io
import stat_helper

fn main() {
    i64 n = 8000000
    i64 reads = 20000000
    i64* s = std.memory.kmm_v4_alloc(64 * 8)
    i64 ns = 0
    i64 acc = 0
    i64 t0 = std.time.time_now_ms()
    s[ns] = std.memory.kmm_v4_total_usage()
    ns += 1
    i64* arr = std.memory.kmm_v4_alloc(n * 8)
    s[ns] = std.memory.kmm_v4_total_usage()
    ns += 1
    i64 i = 0
    while i < n {
        arr[i] = i
        i += 1
    }
    s[ns] = std.memory.kmm_v4_total_usage()
    ns += 1
    i64 seed = 12345
    i64 j = 0
    while j < reads {
        seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
        acc += arr[seed & (n - 1)]
        j += 1
    }
    s[ns] = std.memory.kmm_v4_total_usage()
    ns += 1
    i64 t1 = std.time.time_now_ms()
    std.io.println("[C] rand_64MB        ", t1 - t0, " ms   acc=", acc)
    report(s, ns, "C rand")
}
