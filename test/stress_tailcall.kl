# stress_tailcall.kl — 尾调用改写(TCO) + KMM 作用域深度压力测试
# 覆盖：
#   1. 托管尾递归（每层 KMM 分配）远超 KMM_V4_MAX_SCOPE_DEPTH(1024) 仍正确
#   2. 尾调用实参引用本帧指针对象时退回真实调用（语义必须仍然正确）
#   3. 非尾递归托管递归（调用结果参与后续运算）结果正确
#   4. 互递归托管递归结果正确
#   5. 尾调用 + 分支组合（if/else 两条尾调用路径）
#   6. void 尾调用
# 说明：本文件会输出 recursion_scope_depth 警告——这是预期的：只有被 TCO
# 完全覆盖的递归（1/5/6）不再受 KMM 作用域深度限制，2/3/4 仍是深度受限形状。
import std.io
import std.memory

fn check(bool cond, string label) {
    if cond {
        std.io.println("PASS ", label)
    } else {
        std.io.println("FAIL ", label)
    }
}

# 期望值：非递归求和（避免在测试里依赖类型转换语法）
fn sumTo(i32 n) i32 {
    i32 s = 0
    i32 i = 1
    while i <= n {
        s = s + i
        i = i + 1
    }
    return s
}

# 1) 托管尾递归：每层分配 + 每层回收。改写后复用同一栈帧
fn tailDeep(i32 n, i32 acc) i32 {
    if n == 0 {
        return acc
    }
    i64* p = std.memory.kmm_v4_alloc(64)
    p[0] = n
    return tailDeep(n - 1, acc + n)
}

# 2) 尾调用实参是本帧指针对象 → 不改写（真实调用），验证语义仍正确
fn tailPtrArg(i32 n, i64* first) i32 {
    if n == 0 {
        return first[0]
    }
    i64* p = std.memory.kmm_v4_alloc(64)
    p[0] = n * 2
    return tailPtrArg(n - 1, p)
}

# 3) 非尾递归：调用结果参与后续运算（不做 TCO）
fn nonTail(i32 n) i32 {
    if n == 0 {
        return 0
    }
    i64* p = std.memory.kmm_v4_alloc(32)
    p[0] = n
    return p[0] + nonTail(n - 1)
}

# 4) 互递归托管递归（不做 TCO）
fn isEvenDepth(i32 n) bool {
    if n == 0 {
        return true
    }
    i64* p = std.memory.kmm_v4_alloc(16)
    p[0] = n
    return isOddDepth(n - 1)
}

fn isOddDepth(i32 n) bool {
    if n == 0 {
        return false
    }
    i64* p = std.memory.kmm_v4_alloc(16)
    p[0] = n
    return isEvenDepth(n - 1)
}

# 5) 多个尾调用点（if/else 两条尾调用路径）
# n 偶数层 acc+1、奇数层 acc+2，共 5000 层 ⇒ 2500*1 + 2500*2 = 7500
fn tailTwo(i32 n, i32 acc) i32 {
    if n <= 0 {
        return acc
    }
    i64* p = std.memory.kmm_v4_alloc(16)
    p[0] = n
    if p[0] % 2 == 0 {
        return tailTwo(n - 1, acc + 1)
    } else {
        return tailTwo(n - 1, acc + 2)
    }
}

# 6) void 尾调用
fn tailVoid(i32 n) {
    if n == 0 {
        return
    }
    i64* p = std.memory.kmm_v4_alloc(16)
    p[0] = n
    tailVoid(n - 1)
}

fn main() {
    # 深度远超 KMM_V4_MAX_SCOPE_DEPTH(1024)：无 TCO 时会 KMM FATAL abort
    i32 deep = 20000
    check(tailDeep(deep, 0) == sumTo(deep), "tailDeep 20000 层结果正确")

    i64* head = std.memory.kmm_v4_alloc(64)
    head[0] = 7
    # 传下去的 p 一路覆盖，到 n==0 时读到的是 n==1 那层写的 1*2 = 2
    check(tailPtrArg(10, head) == 2, "尾调用实参为指针对象时结果正确")

    check(nonTail(500) == sumTo(500), "非尾递归 500 层结果正确")
    check(isEvenDepth(300), "互递归 300 层（偶）")
    check(isOddDepth(301), "互递归 301 层（奇）")
    check(tailTwo(5000, 0) == 7500, "多尾调用点分支正确")

    tailVoid(5000)
    check(true, "void 尾调用 5000 层未崩溃")
}
