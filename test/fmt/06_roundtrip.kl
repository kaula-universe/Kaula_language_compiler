import std.io
import std.time
import std.web

enum Color {
    Red
    Green(i32)
}

extern fn boot_main()

fn handle_request(req: HttpRequest*, res: HttpResponse*) {
    char* path = req.path
    http_response_set_status(res, 200)
    http_response_set_body(res, path, 0)
    if req.method == 0 {
        println("GET")
    }
    for i in range(3) {
        println(i)
        break
    }
    match(req.method) {
        0 => println("root")
        _ => println("other")
    }
}

fn main() {
    println("hello")
}
