import std.io

#[sor]
fn probe_statements() {
    for i in range(3) {
        if i == 0 {
            break
        } else {
            continue
        }
    }
    int source = 1
    int target = 0
    int h1 = 0
    int h2 = 0
    int* data = 0
    int out = 0
    yield source -> target
    release source -> [h1, h2]
    extract data[0] -> out
    char c = 'a'
}

fn main() {
    probe_statements()
}
