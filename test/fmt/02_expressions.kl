import std.io

struct Point {
    x: i32
    y: i32
}

fn probe_expressions() {
    int code = 1
    println(sizeof(i32), alignof(i32), offsetof(Point, x))
    println(type_kind(i32), comptime 1 + 2)
    match(code) {
        0 => println("zero")
        1 => println("one")
        _ => println("other")
    }
    Point p = { .x = 1, .y = 2 }
    println(p.x)
}

fn main() {
    probe_expressions()
}
