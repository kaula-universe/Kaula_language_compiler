// literal_semantics.kl —— 字面量语义回归测试。
//
// 守护三个「静默错误」缺陷的修复。它们共同点是：**编译通过、零警告，
// 只安静地给出错答案**，比编译失败更危险。每个断言的期望值都写死在
// 注释里，任何一条回归都会以非零退出码失败。
//
//   1. `[]i32` 复合字面量元素类型（此前硬编码 int64_t → 步长错位）
//   2. 定长数组 `{...}` 初始化器（此前当作 struct literal → 裸值被丢弃）
//   3. `TypeName { field = value }` 无点字段赋值（此前被丢弃 → 全零对象）
//
// 注：`#[derive]` **本身从未损坏**。官方用法是逐字段赋值
//   Point p; p.x = 10; p.y = 20; Point_debug(&p)
// 那条路径在本测试之前就是正确的。本文件里的 check_derive 走的是
// **struct 字面量 + derive** 的组合，它守护的是缺陷 3，不是 derive。
//
// 另注：定长数组的**官方**初始化写法是方括号 `i32 arr[5] = [10, 20, ...]`，
// 那条路径一直正常；花括号 `{...}` 是被误置于 struct-literal 路径才损坏的。

import std.io

struct Point {
    x: i64,
    y: i64
}

#[derive(Debug, Eq)]
struct Pair {
    a: i32,
    b: i32
}

// —— 缺陷 1：[]i32 字面量的元素步长 ——
fn check_i32_slice() i32 {
    []i32 arr = [1, 3, 1990]
    if (arr[0] + arr[1] + arr[2] != 1994) { return 1 }
    if (arr[1] != 3) { return 2 }
    if (arr[2] != 1990) { return 3 }
    return 0
}

// —— 缺陷 1 对照：[]i64 必须保持正确 ——
fn check_i64_slice() i32 {
    []i64 arr = [1, 3, 1990]
    if (arr[0] + arr[1] + arr[2] != 1994) { return 4 }
    return 0
}

// —— 缺陷 2：定长数组花括号初始化器 ——
fn check_fixed_array_init() i32 {
    i32 arr[5] = {10, 20, 30, 40, 50}
    if (arr[0] != 10) { return 5 }
    if (arr[4] != 50) { return 6 }

    // 迭代 + 求和（此前数组全为 0 → 和恒为 0）
    i32 s = 0
    for x in arr {
        s = s + x
    }
    if (s != 150) { return 7 }
    return 0
}

// —— 缺陷 3：无点字段赋值 ——
fn check_struct_literal() i32 {
    Point p = Point { x = 10, y = 20 }
    if (p.x != 10) { return 8 }
    if (p.y != 20) { return 9 }

    // 带点写法必须同样可用（两种都要支持）
    Point q = Point { .x = 7, .y = 8 }
    if (q.x != 7) { return 10 }
    if (q.y != 8) { return 11 }
    return 0
}

// —— 缺陷 4：derive 生成的 equals 必须看到真实字段 ——
fn check_derive() i32 {
    Pair a = Pair { a = 3, b = 4 }
    Pair b = Pair { a = 3, b = 4 }
    Pair c = Pair { a = 3, b = 5 }
    if (Pair_equals(&a, &b) != 1) { return 12 }
    if (Pair_equals(&a, &c) != 0) { return 13 }
    return 0
}

fn main() i32 {
    i32 rc = check_i32_slice()
    if (rc != 0) { return rc }
    rc = check_i64_slice()
    if (rc != 0) { return rc }
    rc = check_fixed_array_init()
    if (rc != 0) { return rc }
    rc = check_struct_literal()
    if (rc != 0) { return rc }
    rc = check_derive()
    if (rc != 0) { return rc }

    std.io.println("literal_semantics ok")
    return 0
}
