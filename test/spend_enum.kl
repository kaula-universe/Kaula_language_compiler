# 正例：枚举模式强制消费（应通过）
import std.io
enum Color {
    Red, Green, Blue
}
fn main() {
    Color c = Color.Red
    int seen = 0
    spend(c) {
        call(Red) { seen = seen + 1 }
        call(Green) { seen = seen + 1 }
        call(Blue) { seen = seen + 1 }
    }
    if seen == 3 {
        println("enum spend OK")
    } else {
        println("enum spend FAIL")
    }
}
