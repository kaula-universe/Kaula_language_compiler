# 璐熶緥锛氬姩鎬佺储寮曪紙搴斿け璐ワ級
import std.io
fn main() {
    auto items = [10, 20, 30]
    int total = 0
    int i = 2
    spend(items) {
        call(1) {
            total = total + items[0]
        }
        call(2) {
            total = total + items[1]
        }
        call(i) {
            total = total + items[2]
        }
    }
    println("unreachable")
}

