# 内核转储文件（根目录 core，曾误提交 488MB 导致 GitHub 拒收）
/core
*.core

# 编译器产物
compiler/kaulac
compiler/kaulac.exe
compiler/version.json
cache/
!compiler/internal/cache/
compiler/cache/

# pkglib 依赖目录（本地放库即用，不入库）
pkglib/

# Rust cargo 构建产物（test/bench/tokio/bench）
# Rust cargo 构建产物。裸 target/ 而非 test/bench/tokio/bench/target/：
# 将来再加别的 crate 不用回来改这里（已确认仓库内无同名源码目录）。
target/

# 本地生成的中间产物和测试执行文件
build/
compiler/build/
compiler/dbg_build_log.txt
__pycache__/
*.pyc
test/*.exe
test/**/*.exe
test/*.o
docs/tutorials/examples/*.exe
docs/tutorials/examples/cache/
demo/*.exe
*.exe

# opencode 配置（本地 AI agent 配置）
.opencode/

# 日志和临时输出
*.log
*.txt

# Linux 编译产物（无扩展名二进制，精确匹配避免误伤源文件）
bin/
