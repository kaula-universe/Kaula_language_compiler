import std.io
import std.net
import std.string

fn handle_client(Socket* client) {
    u8[4096] buffer
    size_t received = tcp_receive(client, buffer, 4096)

    if received > 0 {
        cstring request = (cstring)(buffer)
        std.io.println(request)

        cstring response = "HTTP/1.1 404 Not Found\r\n\r\n"
        if std.string.string_contains_string(request, "GET / ") {
            response = "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\n\r\n<h1>Kaula</h1>"
        }
        if std.string.string_contains_string(request, "GET /hello") {
            response = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\nHello from Kaula!"
        }
        if std.string.string_contains_string(request, "GET /api/info") {
            response = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n{\"server\":\"Kaula\",\"version\":\"1.0\"}"
        }

        std.net.tcp_send(client, (u8*)(response), std.string.string_length(response))
    }

    std.net.socket_close(client)
}

fn main() {
    std.io.println("Kaula HTTP Server on :8080")

    Socket* server = std.net.tcp_server_create("0.0.0.0", 8080)

    if server == null {
        std.io.println("ERROR: Failed to create server")
        return
    }

    while true {
        Socket* client = std.net.socket_accept(server)
        if client != null {
            handle_client(client)
        }
    }
}
