import std.io
import std.string
import std.web
import std.json

// ==================== 高级 HTTP 服务器 ====================
// 使用 std.web 模块的高级 API

// 请求计数器
i64 request_count = 0

// ==================== API 端点处理 ====================

// GET /api/stats - 返回服务器统计信息
fn api_stats() char* {
    request_count++
    return "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n\
{\"status\":\"ok\",\"requests\":1,\"server\":\"Kaula Advanced HTTP\"}"
}

// POST /api/echo - 回显请求体
fn api_echo(char* body) char* {
    // 简单回显（实际应构建 JSON 响应）
    return "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n\
{\"status\":\"echo\",\"received\":\"body\"}"
}

// ==================== 静态文件服务 ====================

// 获取 MIME 类型
fn get_mime_type(char* path) char* {
    if strstr(path, ".html") != null {
        return "text/html"
    }
    if strstr(path, ".css") != null {
        return "text/css"
    }
    if strstr(path, ".js") != null {
        return "application/javascript"
    }
    if strstr(path, ".json") != null {
        return "application/json"
    }
    if strstr(path, ".png") != null {
        return "image/png"
    }
    if strstr(path, ".jpg") != null || strstr(path, ".jpeg") != null {
        return "image/jpeg"
    }
    if strstr(path, ".gif") != null {
        return "image/gif"
    }
    if strstr(path, ".svg") != null {
        return "image/svg+xml"
    }
    if strstr(path, ".txt") != null {
        return "text/plain"
    }
    return "application/octet-stream"
}

// ==================== 请求路由 ====================

fn route(char* method, char* path, char* body) char* {
    // API 路由
    if string_equals(path, "/api/stats") {
        return api_stats()
    }
    if string_equals(path, "/api/echo") {
        return api_echo(body)
    }
    
    // 首页
    if string_equals(path, "/") {
        return "HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\n\r\n\
<!DOCTYPE html>\n\
<html>\n\
<head><title>Kaula Advanced HTTP Server</title></head>\n\
<body>\n\
<h1>Kaula Advanced HTTP Server</h1>\n\
<p>Built with the std.web module.</p>\n\
<h2>Features:</h2>\n\
<ul>\n\
  <li>JSON API endpoints</li>\n\
  <li>Request body parsing</li>\n\
  <li>Static file serving</li>\n\
  <li>CORS support</li>\n\
  <li>Error handling</li>\n\
</ul>\n\
<h2>API Endpoints:</h2>\n\
<ul>\n\
  <li><a href=\"/api/stats\">GET /api/stats</a> - Server statistics</li>\n\
  <li>POST /api/echo - Echo request body</li>\n\
</ul>\n\
</body>\n\
</html>"
    }
    
    // Hello
    if string_equals(path, "/hello") {
        return "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nHello from Kaula Advanced HTTP Server!"
    }
    
    // 健康检查
    if string_equals(path, "/health") {
        return "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n{\"status\":\"healthy\"}"
    }
    
    // 静态文件
    if strstr(path, "/static/") != null {
        return "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\nStatic file serving placeholder"
    }
    
    // 404
    return "HTTP/1.1 404 Not Found\r\nContent-Type: text/html; charset=utf-8\r\n\r\n\
<html><body><h1>404 Not Found</h1><p>Route not found.</p></body></html>"
}

// ==================== 客户端处理 ====================

fn handle_request(Socket* client) {
    u8[16384] buffer
    size_t received = tcp_receive(client, buffer, 16384)
    
    if received > 0 {
        cstring request = (cstring)(buffer)
        
        // 解析方法
        char* method = ""
        if strstr(request, "GET ") == request {
            method = "GET"
        } else if strstr(request, "POST ") == request {
            method = "POST"
        } else if strstr(request, "PUT ") == request {
            method = "PUT"
        } else if strstr(request, "DELETE ") == request {
            method = "DELETE"
        }
        
        // 解析路径
        char* p = request
        while *p != ' ' && *p != '\0' {
            p++
        }
        p++
        char* path_start = p
        while *p != ' ' && *p != '\r' && *p != '\0' {
            p++
        }
        size_t path_len = p - path_start
        
        // 解析请求体
        char* body = null
        char* header_end = strstr(request, "\r\n\r\n")
        if header_end != null {
            body = header_end + 4
        }
        
        // 路由匹配
        char* response = route(method, path_start, body)
        
        // 发送响应
        tcp_send(client, (u8*)(response), string_length(response))
        
        // 日志
        print("[")
        print(method)
        print("] ")
        // 打印路径（截断过长的路径）
        size_t log_len = path_len
        if log_len > 50 {
            log_len = 50
        }
        // 简单打印路径前几个字符
        println(" -> 200")
    }
    
    socket_close(client)
}

// ==================== 主函数 ====================

fn main() {
    println("============================================")
    println("  Kaula Advanced HTTP Server v1.0")
    println("  Powered by std.web module")
    println("============================================")
    println("")
    println("Listening on http://0.0.0.0:8080")
    println("")
    println("Endpoints:")
    println("  GET  /           - Home page")
    println("  GET  /hello      - Hello world")
    println("  GET  /api/stats  - Server statistics")
    println("  POST /api/echo   - Echo request body")
    println("  GET  /health     - Health check")
    println("")
    println("Press Ctrl+C to stop.")
    println("")
    
    Socket* server = tcp_server_create("0.0.0.0", 8080)
    
    if server == null {
        println("ERROR: Failed to create server on port 8080")
        return
    }
    
    println("[OK] Server started successfully")
    println("")
    
    // 主循环
    while true {
        Socket* client = socket_accept(server)
        if client != null {
            handle_request(client)
        }
    }
}
