// hello_xapi.kl — 纯 Kaula 直接调用 XJ380 的 XAPI 用户 API（无 C shim）
//
// 与 hello.kl（shim 版）的区别：
//   - hello.kl 用 freestanding.io.println 输出，靠 xj380_shim.c 覆写弱钩子
//     fs_output_putchar 桥接到 XAPI_OUTPUT；
//   - 本文件不依赖任何 C 适配层，直接声明 extern fn 调用 XJ380 的
//     enter_syscall，并用 `msg.ptr` 取得 C 字符串指针。
//
// 前置条件：kaulac 已修复 freestanding 的 SSO String 定义与 string_cdata
// 兜底宏（见 compiler/templates/freestanding.c.tmpl 与
// compiler/internal/codegen/codegen.go）。修复前必须用
//   -cflags "-include .../freestanding/base/types.h"
// 才能编译；修复后无需任何额外 flags。
//
// 编译与运行见同目录 build_xapi.sh / README.md。

// CStr 是零成本套用类型，C 侧即 typedef const char* CStr;
// 它只声明参数类型，不做值转换——真正把 Kaula String 变成 char* 的是 msg.ptr。
type CStr = adopt const char*

// XJ380 用户态唯一 syscall 入口，实现在 user/xapi/libsys.cpp。
// 变参在 Kaula 侧以固定 6 参数声明（XAPI 只用前两个）。
extern fn enter_syscall(n: u64, p: CStr,
                        a2: u64, a3: u64, a4: u64, a5: u64, a6: u64) -> u64

fn main() -> i32 {
    // XAPI_OUTPUT = 7381：内核把该 NUL 结尾字符串写到串口/控制台。
    // 末尾 \n 让输出与后续内核日志分行（XAPI_OUTPUT 不自动补换行）。
    auto msg = "KAULA-XAPI-DIRECT\n"
    enter_syscall(7381, msg.ptr, 0, 0, 0, 0, 0)
    return 0
}
