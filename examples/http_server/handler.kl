import std.io
import std.net

pub fn handle_request(Socket* client) {
    u8[4096] buffer
    size_t received = tcp_receive(client, buffer, 4096)

    if received > 0 {
        cstring request = (cstring)(buffer)
        cstring response = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\nHello from handler"
        tcp_send(client, (u8*)(response), 53)
    }

    socket_close(client)
}
