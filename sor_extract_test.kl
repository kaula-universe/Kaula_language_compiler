import std.memory
import std.io

fn main() {
	[2]int* slots
	slots[0] = as<int*>(std.memory.std_malloc(64))
	slots[1] = as<int*>(std.memory.std_malloc(64))
	if (slots[0] == null) {
		std.io.println("alloc fail")
		return 1
	}
	if (slots[1] == null) {
		std.io.println("alloc fail")
		return 1
	}

	slots[0][0] = 100
	slots[1][0] = 200

	int* first = null
	extract slots[0] -> first

	std.io.println("first: ", first[0], " slot1: ", slots[1][0])
	if (first[0] == 100) {
		if (slots[1][0] == 200) {
			if (slots[0] == null) {
				std.io.println("EXTRACT OK")
				return 0
			}
		}
	}
	std.io.println("EXTRACT FAIL")
	return 3
}
